        if ! read_choice choice; then return 0; fi
        case "$choice" in
            s|S) sessions_menu ;;
            h|H) normal_shell ;;
            q|Q) clear_screen; return 98 ;;
            x|X) clear_screen; return 99 ;;
            n|N) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            p|P) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            [1-9])
                index=$((start + choice - 1))
                if (( index < end )); then
                    repo="${repos[$index]}"
                    if resolve_repo "$repo"; then project_menu "$RESOLVED_REPO_KEY" "$RESOLVED_REPO_DIR"; else pause_for_ack; fi
                else unknown_key; fi
                ;;
            *) unknown_key ;;
        esac
    done
}

usage() {
    printf '%s\n' 'Użycie:' '  hubi' \
        '  hubi codex REPO [INSTANCE [new|resume]]' \
        '  hubi claude REPO [INSTANCE [new|resume]]' \
        '  hubi shell REPO' '  hubi sessions'
}

hubi_main() {
    local command_name="${1:-menu}" rc=0
    if [[ -n "${HUBI_ACTIVE:-}" ]]; then
        printf 'Hubi: zagnieżdżone uruchomienie jest zabronione (HUBI_ACTIVE jest ustawione).\n' >&2
        return 125
    fi
    export HUBI_ACTIVE=1
    install_signal_handlers
    enable_safe_input
    case "$command_name" in
        menu) main_menu || rc=$? ;;
        codex|claude)
            if (( $# < 2 || $# > 4 )); then
                usage >&2; rc=2
            else
                start_agent "$command_name" "$2" "${3:-primary}" "${4:-new}" || rc=$?
            fi
            ;;
        shell) if (( $# != 2 )); then usage >&2; rc=2; else project_shell "$2" || rc=$?; fi ;;
        sessions) if (( $# != 1 )); then usage >&2; rc=2; else sessions_menu || rc=$?; fi ;;
        *) usage >&2; rc=2 ;;
    esac
    return "$rc"
}

if [[ "${BASH_SOURCE[0]}" == "$0" && "${1:-}" == "__start-locked" ]]; then
    shift
    if (( $# < 6 )); then
        printf 'Hubi: niepełne argumenty wewnętrznego startu.\n' >&2
        exit 2
    fi
    ensure_agent_session_locked "$@"
    exit $?
fi

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    hubi_main "$@"
    exit $?
fi
