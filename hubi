#!/usr/bin/env bash
set -uo pipefail

HUBI_VERSION=4
HUBI_IDENTITY_VERSION=1
HUBI_STATE_SCHEMA=1
HUBI_SCRIPT_PATH="$(realpath -e -- "${BASH_SOURCE[0]}")"
REPOS_ROOT="${HUBI_REPOS:-$HOME/repos}"
TMUX_BIN="${HUBI_TMUX_BIN:-tmux}"
SYSTEMD_RUN_BIN="${HUBI_SYSTEMD_RUN_BIN:-systemd-run}"
SYSTEMCTL_BIN="${HUBI_SYSTEMCTL_BIN:-systemctl}"
FLOCK_BIN="${HUBI_FLOCK_BIN:-flock}"

CODEX_BIN="${HUBI_CODEX_BIN:-$HOME/.npm-global/bin/codex}"
[[ -x "$CODEX_BIN" ]] || CODEX_BIN="$(command -v codex 2>/dev/null || true)"
CLAUDE_BIN="${HUBI_CLAUDE_BIN:-$HOME/.local/bin/claude}"
[[ -x "$CLAUDE_BIN" ]] || CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"

MENU_HINT=""
RESOLVED_REPO_DIR=""
RESOLVED_REPO_KEY=""
RESOLVED_REPO_ID=""
FOUND_SESSION=""
FOUND_PANE=""
ENSURED_SESSION=""
ATTACH_MODE=""
CHOSEN_LAUNCH_MODE=""
RENDER_CRITICAL=0
PENDING_SIGNAL=""
PENDING_SIGNAL_RC=0
STARTUP_WORKER_PID=""
STARTUP_IDENTITY_HASH=""
STARTUP_WATCH_FIFO=""
HUBI_LOCKFD=""
declare -gA REC=()
HUBI_LOCK_TIMEOUT="${HUBI_LOCK_TIMEOUT:-3}"
HUBI_PASTE_TIMEOUT="${HUBI_PASTE_TIMEOUT:-5}"

tmux_cmd() {
    if [[ -n "${HUBI_TMUX_SOCKET:-}" ]]; then
        command env -u HUBI_ACTIVE "$TMUX_BIN" -L "$HUBI_TMUX_SOCKET" "$@"
    else
        command env -u HUBI_ACTIVE "$TMUX_BIN" "$@"
    fi
}

sanitize_tmux_environment() {
    tmux_cmd set-environment -gu HUBI_ACTIVE >/dev/null 2>&1 || true
}

clear_screen() { printf '\033[2J\033[H'; }

enable_safe_input() {
    # Pasted content is bracketed on supporting terminals. Whole-line reads make
    # both those wrappers and ordinary multi-byte escape sequences invalid.
    if [[ -t 0 && -t 1 ]]; then printf '\033[?2004h'; fi
}

disable_safe_input() {
    if [[ -t 1 ]]; then printf '\033[?2004l'; fi
}

discard_queued_input() {
    # A choice is one complete input event. Bytes already queued after its
    # newline belong to the same paste/burst and may not cross a menu boundary.
    while IFS= read -rsn1 -t 0.08 _; do :; done
}

discard_bracketed_paste() {
    local initial="$1" byte tail="$1" deadline complete=0 timeout="$HUBI_PASTE_TIMEOUT"

    if [[ "$initial" == *$'\e[201~'* ]]; then
        discard_queued_input
        return 0
    fi
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || timeout=5
    deadline=$((SECONDS + timeout))
    # read -n switches the tty to character reads, so the closing marker does
    # not need a trailing newline. Embedded newlines are deliberately ignored.
    while (( SECONDS < deadline )) && IFS= read -rsn1 -t "$((deadline - SECONDS))" byte; do
        tail="${tail: -5}${byte}"
        if [[ "$tail" == *$'\e[201~' ]]; then
            complete=1
            break
        fi
    done
    discard_queued_input
    if (( ! complete )); then
        printf '\n  Niepełne wklejenie zostało odrzucone po %ss.\n' "$timeout" >&2
        return 1
    fi
}

on_signal() {
    local signal="$1" rc="$2"
    trap - INT HUP TERM
    printf '\nHubi: odebrano %s; launcher kończy pracę (rc=%s).\n' "$signal" "$rc" >&2
    exit "$rc"
}

# Cancellation of an in-flight managed startup. Runs entirely inside the
# signal handler so a caught INT/HUP/TERM never lets the launcher exit while a
# detached worker keeps mutating tmux/systemd state on its own (P2-05).
#
# Killing the flock supervisor itself (not a process group — the worker
# stays in the launcher's own group, so a group-wide signal already reaches
# it directly) releases the identity lock immediately: the locked fd lives
# in flock's own descriptor table, never inherited by the --close'd worker
# command, so the lock is gone as soon as that one process dies — bounding
# cancellation without needing to reach into whatever tmux/systemd-run
# subprocess it may currently be blocked on.
#
# This alone only reliably reconciles a bootstrap AFTER its trusted STARTING
# record exists. The earlier window — the worker still resolving tmux/repo
# checks or blocked inside its first tmux new-session call — is covered
# separately by the parent-death watchdog the worker itself arms (see
# start_parent_death_watchdog): our own exit here (for any reason, including
# a signal this trap cannot even catch) closes STARTUP_WATCH_FIFO's write
# end, which is what that watchdog is actually waiting on.
cancel_startup_worker() {
    local signal="$1" rc="$2" pid="$STARTUP_WORKER_PID" hash="$STARTUP_IDENTITY_HASH" fifo="$STARTUP_WATCH_FIFO" waited=0
    trap - INT HUP TERM
    STARTUP_WORKER_PID=""
    STARTUP_IDENTITY_HASH=""
    STARTUP_WATCH_FIFO=""
    printf '\nHubi: odebrano %s podczas startu; anulowanie i wycofywanie zmian.\n' "$signal" >&2
    kill -TERM "$pid" 2>/dev/null || true
    while (( waited < 20 )) && kill -0 "$pid" 2>/dev/null; do sleep 0.1; ((waited += 1)); done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
        sleep 0.2
    fi
    wait "$pid" 2>/dev/null || true
    [[ -z "$hash" ]] || rollback_starting_record "$hash"
    [[ -z "$fifo" ]] || rm -f -- "$fifo" 2>/dev/null || true
    exit "$rc"
}

handle_signal() {
    local signal="$1" rc="$2"
    if [[ -n "$STARTUP_WORKER_PID" ]]; then
        cancel_startup_worker "$signal" "$rc"
    fi
    if (( RENDER_CRITICAL )); then
        if [[ -z "$PENDING_SIGNAL" ]]; then
            PENDING_SIGNAL="$signal"
            PENDING_SIGNAL_RC="$rc"
        fi
        return
    fi
    on_signal "$signal" "$rc"
}

begin_render_critical() {
    RENDER_CRITICAL=1
}

end_render_critical() {
    RENDER_CRITICAL=0
    if [[ -n "$PENDING_SIGNAL" ]]; then
        on_signal "$PENDING_SIGNAL" "$PENDING_SIGNAL_RC"
    fi
}

install_signal_handlers() {
    trap 'handle_signal INT 130' INT
    trap 'handle_signal HUP 129' HUP
    trap 'handle_signal TERM 143' TERM
    trap disable_safe_input EXIT
}

pause_for_ack() {
    local value
    enable_safe_input
    discard_queued_input
    printf '\n  Enter, aby kontynuować... '
    if IFS= read -r value; then
        if [[ "$value" == *$'\e[200~'* ]]; then
            discard_bracketed_paste "$value"
        else
            discard_queued_input
        fi
    fi
    enable_safe_input
}

read_choice() {
    local variable="$1" value
    # This is deliberately not read -n1. A valid command is exactly one line
    # containing one character; arrows, terminal replies and paste are ignored.
    enable_safe_input
    if ! IFS= read -r value; then return 1; fi
    if [[ "$value" == *$'\e[200~'* ]]; then
        discard_bracketed_paste "$value"
        value=""
    else
        discard_queued_input
    fi
    printf -v "$variable" '%s' "$value"
}

read_text_value() {
    local variable="$1" value
    enable_safe_input
    if ! IFS= read -r value; then return 1; fi
    if [[ "$value" == *$'\e[200~'* ]]; then
        discard_bracketed_paste "$value"
        value=""
    else
        discard_queued_input
    fi
    printf -v "$variable" '%s' "$value"
}

show_hint() {
    if [[ -n "$MENU_HINT" ]]; then
        printf '  %s\n\n' "$MENU_HINT"
        MENU_HINT=""
    fi
}

unknown_key() { MENU_HINT="Nieznany wybór — wpisz jeden z pokazanych klawiszy i naciśnij Enter."; }
repo_error() { printf 'Hubi: %s\n' "$*" >&2; }

resolve_repo() {
    local argument="$1" root candidate top
    RESOLVED_REPO_DIR=""
    RESOLVED_REPO_KEY=""
    RESOLVED_REPO_ID=""

    if [[ -z "$argument" || "$argument" == /* || "$argument" == *$'\n'* ]]; then
        repo_error "nieprawidłowa nazwa repozytorium: ${argument:-<pusta>}"
        return 2
    fi
    case "/$argument/" in
        */../*|*/./*|*//* )
            repo_error "ścieżka repozytorium nie może zawierać '..', '.' ani pustych segmentów: $argument"
            return 2
            ;;
    esac

    if ! root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null)" || [[ ! -d "$root" ]]; then
        repo_error "katalog repozytoriów nie istnieje: $REPOS_ROOT"
        return 2
    fi
    if ! candidate="$(realpath -e -- "$root/$argument" 2>/dev/null)" || [[ ! -d "$candidate" ]]; then
        repo_error "repozytorium nie istnieje: $root/$argument"
        return 2
    fi
    case "$candidate/" in
        "$root"/*) ;;
        *) repo_error "repozytorium musi znajdować się pod $root"; return 2 ;;
    esac

    if ! top="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)"; then
        repo_error "to nie jest repozytorium Git: $candidate"
        return 2
    fi
    top="$(realpath -e -- "$top" 2>/dev/null)" || {
        repo_error "nie można rozwiązać katalogu repozytorium: $candidate"
        return 2
    }
    if [[ "$top" != "$candidate" ]]; then
        repo_error "podana ścieżka nie jest katalogiem głównym repozytorium Git: $argument"
        return 2
    fi
    RESOLVED_REPO_DIR="$candidate"
    RESOLVED_REPO_KEY="${candidate#"$root"/}"
    RESOLVED_REPO_ID="$(stat -Lc '%d:%i' -- "$candidate" 2>/dev/null)" || {
        repo_error "nie można ustalić tożsamości repozytorium: $candidate"
        RESOLVED_REPO_DIR=""
        RESOLVED_REPO_KEY=""
        return 2
    }
}

# Revalidates that canonical_path still is the exact same Git repository root,
# still under REPOS_ROOT, and still the same filesystem object as expected_id.
# This is the P1-02 boundary: canonical_path defines the namespace, and
# device/inode detects a replacement of whatever now lives at that path.
revalidate_repo_for_start() {
    local canonical_path="$1" expected_repo_id="$2" root candidate top actual_id
    if ! root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null)" || [[ ! -d "$root" ]]; then
        repo_error "katalog repozytoriów zniknął przed startem: $REPOS_ROOT"
        return 1
    fi
    if ! candidate="$(realpath -e -- "$canonical_path" 2>/dev/null)" || [[ ! -d "$candidate" ]]; then
        repo_error "repozytorium zniknęło przed startem: $canonical_path"
        return 1
    fi
    if [[ "$candidate" != "$canonical_path" ]]; then
        repo_error "ścieżka repozytorium zmieniła się przed startem: $canonical_path"
        return 1
    fi
    case "$candidate/" in
        "$root"/*) ;;
        *) repo_error "repozytorium nie znajduje się już pod $root"; return 1 ;;
    esac
    if ! top="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)" \
        || ! top="$(realpath -e -- "$top" 2>/dev/null)" \
        || [[ "$top" != "$candidate" ]]; then
        repo_error "katalog nie jest już tym samym repozytorium Git: $canonical_path"
        return 1
    fi
    actual_id="$(stat -Lc '%d:%i' -- "$candidate" 2>/dev/null)" || {
        repo_error "nie można ponownie ustalić tożsamości repozytorium: $canonical_path"
        return 1
    }
    if [[ -z "$expected_repo_id" || "$actual_id" != "$expected_repo_id" ]]; then
        repo_error "tożsamość repozytorium zmieniła się przed startem (repozytorium zostało zastąpione): $canonical_path"
        return 1
    fi
}

repo_list() {
    local root directory top resolved
    root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null)" || return 0
    [[ -d "$root" ]] || return 0
    while IFS= read -r -d '' directory; do
        top="$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null || true)"
        [[ -n "$top" ]] || continue
        resolved="$(realpath -e -- "$top" 2>/dev/null || true)"
        [[ "$resolved" == "$directory" ]] || continue
        printf '%s\n' "${directory#"$root"/}"
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null) | sort
}

# ---------------------------------------------------------------------------
# Versioned identity encoding (P1-01, P2-07).
#
# Every managed identity is (identity_version, canonical_repo_path, agent,
# instance). Fields are encoded with an explicit byte-length prefix, which is
# a provably unambiguous (uniquely decodable) encoding: no delimiter
# concatenation of the raw fields is used, so a repo key/path containing ':'
# or any other character can never be reinterpreted as a different tuple.
# ---------------------------------------------------------------------------
identity_encode() {
    local LC_ALL=C part
    for part in "$@"; do
        printf '%s:%s' "${#part}" "$part"
    done
}

compute_identity_hash() {
    # args: canonical_path agent instance
    identity_encode "$HUBI_IDENTITY_VERSION" "$1" "$2" "$3" | sha256sum | cut -c1-16
}

random_token() {
    if [[ -r /dev/urandom ]]; then
        od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n'
    else
        printf '%s-%s-%s' "$(date +%s%N)" "$RANDOM" "$RANDOM"
    fi
}

safe_slug() {
    local slug
    slug="$(printf '%s' "$1" | tr -c '[:alnum:]_-' '-')"
    slug="${slug:0:28}"
    [[ -n "$slug" ]] || slug="repo"
    printf '%s' "$slug"
}
validate_instance_name() {
    local instance="$1"
    if [[ ! "$instance" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}$ ]]; then
        printf 'Hubi: nieprawidłowa nazwa instancji: %s (dozwolone: 1-32 znaki alfanumeryczne, _ i -; pierwszy znak alfanumeryczny).\n' \
            "${instance:-<pusta>}" >&2
        return 2
    fi
}

# Current (v4.1+) naming: cosmetic slug plus the full structured identity
# hash. Uniqueness comes entirely from the hash; the slug never needs to be
# unique and repo-root collisions (P1-01) cannot alias two identities because
# canonical_path (not a REPOS_ROOT-relative key) feeds the hash.
agent_session_name() {
    local agent="$1" canonical_path="$2" instance="${3:-primary}" hash
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    if [[ "$instance" == "primary" ]]; then
        printf 'hubi-%s-%s-%s' "$agent" "$(safe_slug "${canonical_path##*/}")" "$hash"
    else
        printf 'hubi-%s-%s-%s-%s' "$agent" "$(safe_slug "$instance")" "$(safe_slug "${canonical_path##*/}")" "$hash"
    fi
}

agent_scope_name() {
    local agent="$1" canonical_path="$2" instance="${3:-primary}" hash
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    if [[ "$instance" == "primary" ]]; then
        printf 'hubi-%s-%s.scope' "$agent" "$hash"
    else
        printf 'hubi-%s-%s-%s.scope' "$agent" "$(safe_slug "$instance")" "$hash"
    fi
}

# ---------------------------------------------------------------------------
# Private runtime directories (P3-01): the same secure-directory validation
# applies uniformly to every Hubi runtime root, not only the /tmp fallback.
# Never silently repairs a pre-existing unsafe object; fails closed.
# ---------------------------------------------------------------------------
secure_fallback_lock_root() {
    local root="$1" metadata
    if [[ -L "$root" ]]; then return 1; fi
    if [[ ! -e "$root" ]]; then
        # A concurrent caller may win this race and create it first; that is
        # fine as long as what exists afterward is still a valid secure
        # directory, which the checks below verify regardless of who made it.
        mkdir -m 700 -- "$root" 2>/dev/null || true
    fi
    [[ -d "$root" && ! -L "$root" ]] || return 1
    metadata="$(stat -c '%u:%a' -- "$root")" || return 1
    [[ "$metadata" == "$UID:700" ]] || return 1
    printf '%s' "$root"
}

hubi_runtime_base() {
    local base
    if [[ -n "${HUBI_RUNTIME_DIR:-}" ]]; then
        base="$HUBI_RUNTIME_DIR"
    elif [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
        base="$XDG_RUNTIME_DIR/hubi-${UID}"
    else
        base="/tmp/hubi-${UID}"
    fi
    secure_fallback_lock_root "$base"
}

lock_root() {
    local base
    base="$(hubi_runtime_base)" || return 1
    secure_fallback_lock_root "$base/locks"
}

state_root() {
    local base
    base="$(hubi_runtime_base)" || return 1
    secure_fallback_lock_root "$base/state"
}

# Private root for the parent-death watchdog FIFO (P2-05): same secure
# validation as lock_root/state_root, never a bare /tmp path.
watch_root() {
    local base
    base="$(hubi_runtime_base)" || return 1
    secure_fallback_lock_root "$base/watch"
}

# ---------------------------------------------------------------------------
# Trusted ownership record (P2-03, P2-04, P2-07, P2-08).
#
# One record per identity hash, stored as strict key=value lines under the
# private state root (owner-only 600, no symlinks, atomic rename-into-place).
# This file — not a predictable tmux/systemd name, and not a token embedded
# only in tmux's own (equally predictable/forgeable) metadata — is what
# authorizes destructive lifecycle operations.
# ---------------------------------------------------------------------------
write_state_record() {
    local hash="$1" dir tmp kv
    shift
    dir="$(state_root)" || return 1
    tmp="$dir/.tmp-$hash-$$-$RANDOM"
    {
        printf 'schema=%s\n' "$HUBI_STATE_SCHEMA"
        for kv in "$@"; do
            [[ "$kv" != *$'\n'* ]] || return 1
            printf '%s\n' "$kv"
        done
    } >"$tmp" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
    chmod 600 -- "$tmp" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
    mv -f -- "$tmp" "$dir/$hash.rec" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
}

# Sets REC[...] and returns: 0 valid/trusted, 1 absent, 2 malformed/untrusted
# (bad permissions, a symlink, or content that fails strict parsing). A
# malformed record must never be treated as ownership proof.
load_state_record() {
    local hash="$1" dir file line key value metadata
    REC=()
    dir="$(state_root)" || return 2
    file="$dir/$hash.rec"
    if [[ -L "$file" ]]; then return 2; fi
    [[ -e "$file" ]] || return 1
    [[ -f "$file" ]] || return 2
    metadata="$(stat -c '%u:%a' -- "$file" 2>/dev/null)" || return 2
    [[ "$metadata" == "$UID:600" ]] || return 2
    while IFS= read -r line; do
        [[ "$line" =~ ^([a-z_]+)=(.*)$ ]] || return 2
        key="${BASH_REMATCH[1]}"
        value="${BASH_REMATCH[2]}"
        REC["$key"]="$value"
    done < "$file"
    [[ "${REC[schema]:-}" == "$HUBI_STATE_SCHEMA" ]] || return 2
    [[ -n "${REC[session]:-}" && -n "${REC[scope]:-}" && -n "${REC[token]:-}" && -n "${REC[state]:-}" ]] || return 2
    return 0
}

delete_state_record() {
    local hash="$1" dir
    dir="$(state_root)" 2>/dev/null || return 0
    rm -f -- "$dir/$hash.rec" 2>/dev/null || true
}

verify_record_matches_repo() {
    local canonical_path="$1" current_id
    [[ "${REC[canonical_path]:-}" == "$canonical_path" ]] || return 1
    if current_id="$(stat -Lc '%d:%i' -- "$canonical_path" 2>/dev/null)"; then
        [[ "${REC[repo_dev_inode]:-}" == "$current_id" ]] || return 1
    fi
    return 0
}

# Cross-checks the live tmux session/pane against a loaded trusted record.
verify_record_live_session() {
    local agent="$1" instance="$2" session="${REC[session]}" pane="${REC[pane]}" pane_session
    tmux_cmd has-session -t "$session" 2>/dev/null || return 1
    [[ "$(tmux_cmd show-option -qv -t "$session" @hubi-managed 2>/dev/null || true)" == v4 ]] || return 1
    [[ "$(tmux_cmd show-option -qv -t "$session" @hubi-token 2>/dev/null || true)" == "${REC[token]}" ]] || return 1
    [[ "$(tmux_cmd show-option -qv -t "$session" @hubi-agent 2>/dev/null || true)" == "$agent" ]] || return 1
    [[ "$(tmux_cmd show-option -qv -t "$session" @hubi-instance 2>/dev/null || true)" == "$instance" ]] || return 1
    pane_session="$(tmux_cmd display-message -p -t "$pane" '#S' 2>/dev/null || true)"
    [[ "$pane_session" == "$session" ]] || return 1
}

# OS-level cross-check: every scope Hubi creates carries a systemd unit
# Description tying it to its trusted record's token (clean-install: there
# is no compatibility case where a scope Hubi is willing to touch could
# lack this). Terminating a scope without a token to check at all is a
# narrow, deliberate exception — see terminate_scope.
verify_scope_description_token() {
    local scope="$1" token="$2" desc
    [[ -n "$token" ]] || return 1
    desc="$("$SYSTEMCTL_BIN" --user show -p Description --value -- "$scope" 2>/dev/null)" || return 1
    [[ "$desc" == "hubi-owned:$token" ]]
}

# ---------------------------------------------------------------------------
# Discovery (P1-01, P1-02, P2-03, P2-08, P3-03).
#
# Clean-install contract: Hubi manages ONLY objects created by this trusted-
# state architecture. A tmux session or systemd scope with a matching or
# predictable name that does NOT carry a valid current trusted ownership
# record is not our object — never claimed, never mutated, never killed.
# There is no migration/adoption path for anything created by an older Hubi.
#
# Returns via FOUND_SESSION and exit status:
#   0  found and verified as a managed session
#   1  not found (absent)
#   3  CONFLICT: a session at the exact expected name exists but does not
#      verify — never treated as managed, never destroyed by name alone
#   4  STARTING: our own bootstrap is verifiably in progress
# ---------------------------------------------------------------------------
find_agent_session() {
    local agent="$1" canonical_path="$2" instance="${3:-primary}"
    local session hash record_rc live_token
    FOUND_SESSION=""
    validate_instance_name "$instance" || return 2

    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    session="$(agent_session_name "$agent" "$canonical_path" "$instance")"

    load_state_record "$hash"; record_rc=$?
    if (( record_rc == 0 )) && [[ "${REC[state]}" == COMMITTED ]]; then
        if verify_record_matches_repo "$canonical_path" && verify_record_live_session "$agent" "$instance" \
            && [[ "${REC[session]}" == "$session" ]]; then
            FOUND_SESSION="${REC[session]}"
            return 0
        fi
        if ! tmux_cmd has-session -t "${REC[session]}" 2>/dev/null; then
            return 1
        fi
        FOUND_SESSION="${REC[session]}"
        return 3
    fi

    if tmux_cmd has-session -t "$session" 2>/dev/null; then
        if (( record_rc == 0 )) && [[ "${REC[state]}" == STARTING && "${REC[session]}" == "$session" ]]; then
            live_token="$(tmux_cmd show-option -qv -t "$session" @hubi-token 2>/dev/null || true)"
            if [[ "$live_token" == "${REC[token]}" ]]; then
                FOUND_SESSION="$session"
                return 4
            fi
        fi
        FOUND_SESSION="$session"
        return 3
    fi

    return 1
}

agent_instance_list() {
    local LC_ALL=C
    local agent="$1" canonical_path="$2" record field_length
    local -a fields=()
    local session managed stored_agent stored_repo_canon instance dir rec_file rec_hash
    {
        printf 'primary\n'
        while IFS= read -r record; do
            fields=()
            for _ in {1..5}; do
                if [[ "$record" =~ ^([0-9]+):(.*)$ ]]; then
                    field_length="${BASH_REMATCH[1]}"
                    record="${BASH_REMATCH[2]}"
                else
                    fields=()
                    break
                fi
                if (( ${#record} < field_length )); then
                    fields=()
                    break
                fi
                fields+=("${record:0:field_length}")
                record="${record:field_length}"
            done
            (( ${#fields[@]} == 5 )) || continue
            session="${fields[0]}"
            managed="${fields[1]}"
            stored_agent="${fields[2]}"
            stored_repo_canon="${fields[3]}"
            instance="${fields[4]}"
            [[ "$managed" == "v4" && "$stored_agent" == "$agent" ]] || continue
            [[ -n "$stored_repo_canon" && "$stored_repo_canon" == "$canonical_path" ]] || continue
            validate_instance_name "$instance" >/dev/null 2>&1 || continue
            printf '%s\n' "$instance"
        done < <(tmux_cmd list-sessions -F \
            '#{n:session_name}:#{session_name}#{n:@hubi-managed}:#{@hubi-managed}#{n:@hubi-agent}:#{@hubi-agent}#{n:@hubi-repo-canon}:#{@hubi-repo-canon}#{n:@hubi-instance}:#{@hubi-instance}' \
            2>/dev/null || true)

        # Trusted records are the authoritative source for instances whose
        # tmux session is gone but whose scope may still be alive (P2-08):
        # exact instance names, no fragile reverse-parsing of a hashed name.
        dir="$(state_root)" 2>/dev/null || dir=""
        if [[ -n "$dir" && -d "$dir" ]]; then
            for rec_file in "$dir"/*.rec; do
                [[ -e "$rec_file" ]] || continue
                rec_hash="${rec_file##*/}"; rec_hash="${rec_hash%.rec}"
                load_state_record "$rec_hash" || continue
                [[ "${REC[state]}" == COMMITTED ]] || continue
                [[ "${REC[agent]}" == "$agent" && "${REC[canonical_path]}" == "$canonical_path" ]] || continue
                validate_instance_name "${REC[instance]}" >/dev/null 2>&1 || continue
                printf '%s\n' "${REC[instance]}"
            done
        fi
    } | awk '!seen[$0]++'
}

session_count() {
    local sessions
    sessions="$(tmux_cmd list-sessions -F '#S' 2>/dev/null || true)"
    if [[ -z "$sessions" ]]; then printf '0'; else printf '%s\n' "$sessions" | wc -l; fi
}

session_clients() {
    local clients
    clients="$(tmux_cmd list-clients -t "$1" -F '#{client_name}' 2>/dev/null || true)"
    if [[ -z "$clients" ]]; then printf '0'; else printf '%s\n' "$clients" | wc -l; fi
}

agent_pane() {
    local session="$1" pane pane_session
    FOUND_PANE=""
    pane="$(tmux_cmd show-option -qv -t "$session" @hubi-pane 2>/dev/null || true)"
    [[ "$pane" == %* ]] || return 1
    pane_session="$(tmux_cmd display-message -p -t "$pane" '#S' 2>/dev/null || true)"
    [[ "$pane_session" == "$session" ]] || return 1
    FOUND_PANE="$pane"
}

session_is_managed() {
    [[ "$(tmux_cmd show-option -qv -t "$1" @hubi-managed 2>/dev/null || true)" == "v4" ]]
}

session_is_dead() {
    local session="$1"
    if session_is_managed "$session"; then
        agent_pane "$session" || return 0
        [[ "$(tmux_cmd display-message -p -t "$FOUND_PANE" '#{pane_dead}' 2>/dev/null || true)" == "1" ]]
    else
        [[ "$(tmux_cmd display-message -p -t "$session:" '#{pane_dead}' 2>/dev/null || true)" == "1" ]]
    fi
}

session_status() {
    local session="$1" clients
    if ! tmux_cmd has-session -t "$session" 2>/dev/null; then
        printf '○ STOPPED'
    elif session_is_dead "$session"; then
        printf '⚠ EXITED'
    else
        clients="$(session_clients "$session")"
        if (( clients > 0 )); then printf '● ATTACHED (%d)' "$clients"; else printf '● RUNNING'; fi
    fi
}

# agent_status surfaces explicit CONFLICT/STARTING/UNKNOWN states instead of
# silently downgrading an unresolved ownership question to STOPPED (P3-03).
agent_status() {
    local agent="$1" canonical_path="$2" instance="${3:-primary}" scope hash find_rc st
    validate_instance_name "$instance" || return 2
    find_agent_session "$agent" "$canonical_path" "$instance"; find_rc=$?
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    case "$find_rc" in
        0)
            scope="$(agent_scope_name "$agent" "$canonical_path" "$instance")"
            load_state_record "$hash" && scope="${REC[scope]}"
            scope_state "$scope"; st=$?
            if session_is_dead "$FOUND_SESSION"; then
                case "$st" in
                    0) printf '⚠ EXITED / STALE SCOPE' ;;
                    2) printf '⚠ EXITED / UNKNOWN SCOPE' ;;
                    *) printf '⚠ EXITED' ;;
                esac
            else
                case "$st" in
                    1) printf '⚠ STALE SESSION' ;;
                    2) printf '⚠ RUNNING / UNKNOWN SCOPE' ;;
                    *) session_status "$FOUND_SESSION" ;;
                esac
            fi
            ;;
        3) printf '⚠ CONFLICT' ;;
        4) printf '… STARTING' ;;
        *)
            if load_state_record "$hash" && [[ "${REC[state]}" == COMMITTED ]]; then
                scope_state "${REC[scope]}"; st=$?
                case "$st" in
                    0) printf '⚠ ORPHANED' ;;
                    2) printf '⚠ UNKNOWN' ;;
                    *) printf '○ STOPPED' ;;
                esac
            else
                printf '○ STOPPED'
            fi
            ;;
    esac
}

git_summary() {
    local directory="$1" branch state
    branch="$(git -C "$directory" branch --show-current 2>/dev/null || true)"
    [[ -n "$branch" ]] || branch="$(git -C "$directory" rev-parse --short HEAD 2>/dev/null || printf '?')"
    if [[ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]]; then state="dirty"; else state="clean"; fi
    printf '%s / %s' "$branch" "$state"
}

capture_session_output() {
    local session="$1"
    if session_is_managed "$session"; then
        if ! agent_pane "$session"; then
            printf 'Hubi: brak przypiętego panelu agenta w sesji %s.\n' "$session" >&2
            return 1
        fi
        tmux_cmd capture-pane -p -S -200 -t "$FOUND_PANE" 2>/dev/null || true
    else
        tmux_cmd capture-pane -p -S -200 -t "$session:" 2>/dev/null || true
    fi
}

choose_attach_mode() {
    local session="$1" clients choice
    ATTACH_MODE=""
    clients="$(session_clients "$session")"
    if (( clients == 0 )); then ATTACH_MODE="write"; return 0; fi
    printf '\n  Sesja ma już podłączonych klientów: %d\n' "$clients"
    printf '  [v] Tylko podgląd\n  [s] Współdziel sterowanie\n'
    printf '  [p] Przejmij (odłącz pozostałych)\n  [b] Powrót\n  > '
    if ! read_choice choice; then return 1; fi
    case "$choice" in
        v|V) ATTACH_MODE="readonly" ;;
        s|S) ATTACH_MODE="write" ;;
        p|P) ATTACH_MODE="takeover" ;;
        b|B) return 1 ;;
        *) printf '  Nieznany wybór; nie podłączono sesji.\n'; return 1 ;;
    esac
}

attach_session() {
    local session="$1" mode rc=0
    if [[ -n "${TMUX:-}" ]]; then
        printf '\n  Hubi działa poza tmuxem. Najpierw odłącz bieżącą sesję.\n' >&2
        pause_for_ack
        return 1
    fi
    if ! tmux_cmd has-session -t "$session" 2>/dev/null; then
        printf '\n  Nie ma sesji tmux: %s\n' "$session" >&2
        pause_for_ack
        return 1
    fi
    # Attaching is an explicit initialization boundary. Remove any stale
    # launcher-only guard before this client or later panes use the server.
    sanitize_tmux_environment
    choose_attach_mode "$session" || { enable_safe_input; discard_queued_input; return 0; }
    mode="$ATTACH_MODE"
    clear_screen
    case "$mode" in
        readonly) tmux_cmd attach-session -r -t "$session" || rc=$? ;;
        takeover) tmux_cmd attach-session -d -t "$session" || rc=$? ;;
        write) tmux_cmd attach-session -t "$session" || rc=$? ;;
    esac
    enable_safe_input
    discard_queued_input
    if (( rc != 0 )); then
        printf '\n  BŁĄD: nie udało się podłączyć sesji %s (rc=%d).\n' "$session" "$rc" >&2
        printf '  Powyższy komunikat tmux został zachowany.\n' >&2
        pause_for_ack
        return "$rc"
    fi
    clear_screen
}

# ---------------------------------------------------------------------------
# Per-identity mutation lock (P2-06): start, stop and orphan reconciliation
# for the same identity all serialize through the exact same lock file, keyed
# by the structured identity hash. Independent identities never block on
# each other.
# ---------------------------------------------------------------------------
run_under_identity_lock() {
    local hash="$1" timeout="$2" locks lock_file
    HUBI_LOCKFD=""
    locks="$(lock_root)" || return 1
    lock_file="$locks/$hash.lock"
    exec {HUBI_LOCKFD}<>"$lock_file" || { HUBI_LOCKFD=""; return 1; }
    if ! "$FLOCK_BIN" --wait "$timeout" "$HUBI_LOCKFD"; then
        exec {HUBI_LOCKFD}<&-
        HUBI_LOCKFD=""
        return 75
    fi
}

release_identity_lock() {
    [[ -n "$HUBI_LOCKFD" ]] || return 0
    "$FLOCK_BIN" --unlock "$HUBI_LOCKFD" 2>/dev/null || true
    # A bare `exec` (no command) applies its redirections to this shell
    # permanently, not just to the exec call itself — a trailing
    # `2>/dev/null` here would silently swallow every later diagnostic this
    # process ever prints. Do not add one.
    exec {HUBI_LOCKFD}<&- || true
    HUBI_LOCKFD=""
}

ensure_agent_session() {
    local agent="$1" canonical_path="$2" executable="$3"
    shift 3
    ensure_agent_instance_session "$agent" "$canonical_path" primary "$executable" "$@"
}

# Orchestrates one managed startup: acquires the identity lock, then runs the
# actual bootstrap in a supervised worker of its own session/process group
# (P2-05) so a caught INT/HUP/TERM here can forward cancellation to the whole
# startup subtree instead of leaving it to finish unsupervised.
ensure_agent_instance_session() {
    local agent="$1" canonical_path="$2" instance="$3" executable="$4"
    shift 4
    local -a arguments=("$@")
    local hash locks lock_file rc output tmp_out worker_pid expected_repo_id
    local watch_dir watch_fifo watch_write_fd
    ENSURED_SESSION=""
    validate_instance_name "$instance" || return 2
    expected_repo_id="$RESOLVED_REPO_ID"
    require_scope_kill_capability || return 1
    revalidate_repo_for_start "$canonical_path" "$expected_repo_id" || return 1
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    locks="$(lock_root)" || { printf 'Hubi: nie można utworzyć katalogu blokad startowych.\n' >&2; return 1; }
    lock_file="$locks/$hash.lock"
    if [[ ! "$HUBI_LOCK_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
        printf 'Hubi: nieprawidłowy limit oczekiwania na blokadę: %s\n' "$HUBI_LOCK_TIMEOUT" >&2
        return 1
    fi

    tmp_out="$(mktemp "${TMPDIR:-/tmp}/hubi-start.XXXXXX" 2>/dev/null)" || {
        printf 'Hubi: nie można utworzyć pliku tymczasowego startu.\n' >&2
        return 1
    }

    # Parent-death watchdog (P2-05): a FIFO whose write end only WE hold
    # open. We pass its path to the worker, which opens the read end and
    # blocks on it in the background from the moment it is about to create
    # anything. File-descriptor closure on process exit is unconditional
    # kernel behavior — it happens whether we exit cleanly, via a caught
    # signal, or via an uncatchable SIGKILL — so the worker's watchdog sees
    # EOF and stops the worker even in the one case cancel_startup_worker's
    # trap cannot help with at all.
    #
    # This is a required startup precondition (P2-03), not best-effort: if
    # it cannot be established, startup fails closed here — before the flock
    # supervisor or anything else is spawned — rather than silently proceed
    # without the one protection that covers the window before any trusted
    # STARTING record exists.
    watch_fifo=""
    watch_write_fd=""
    if ! watch_dir="$(watch_root)" 2>/dev/null; then
        printf 'Hubi: nie można utworzyć bezpiecznego katalogu obserwatora startu (watchdog); odmowa startu (fail-closed).\n' >&2
        rm -f -- "$tmp_out" 2>/dev/null
        return 1
    fi
    watch_fifo="$watch_dir/$hash-$$-$RANDOM.fifo"
    if ! mkfifo -m 600 -- "$watch_fifo" 2>/dev/null; then
        printf 'Hubi: nie można utworzyć FIFO obserwatora startu (watchdog); odmowa startu (fail-closed).\n' >&2
        watch_fifo=""
        rm -f -- "$tmp_out" 2>/dev/null
        return 1
    fi
    # Opened read-write (not write-only): a plain write-only open would
    # block right here until a reader opens the FIFO, but the worker that
    # will do that hasn't even been spawned yet. O_RDWR on a FIFO never
    # blocks (the fd trivially satisfies "a peer exists" against itself)
    # while still behaving as a writer for the worker's blocking read to
    # see EOF against once we close it.
    #
    # NOTE: a bare `exec` (no command) applies its redirections to THIS
    # shell permanently, not just to the exec call itself — a trailing
    # `2>/dev/null` here would silently swallow every later diagnostic this
    # function prints. Do not add one.
    if ! exec {watch_write_fd}<>"$watch_fifo"; then
        printf 'Hubi: nie można otworzyć FIFO obserwatora startu (watchdog); odmowa startu (fail-closed).\n' >&2
        watch_write_fd=""
        rm -f -- "$watch_fifo" "$tmp_out" 2>/dev/null
        watch_fifo=""
        return 1
    fi
    STARTUP_WATCH_FIFO="$watch_fifo"

    # flock owns the descriptor in a supervisor. --close guarantees that the
    # worker, tmux server, agent and every descendant start without that fd,
    # so killing the flock supervisor process alone (see
    # cancel_startup_worker) releases the lock immediately regardless of
    # what its child is currently doing. The worker stays in the launcher's
    # own process group deliberately: a group-wide signal (e.g. the whole
    # session being torn down) already reaches it directly with no trap
    # needed, same as before this revision.
    #
    # watch_write_fd is explicitly closed for this one command below
    # (`{watch_write_fd}<&-`) — a plain fd opened via `exec {var}<>file` is
    # NOT close-on-exec by default, so without this the worker (and its own
    # watchdog, forked further from it) would inherit our copy of the write
    # end and the FIFO would never actually reach EOF when we exit: it would
    # always still have this inherited writer reference open, defeating the
    # whole mechanism. This closes only the child's copy; ours stays open.
    "$FLOCK_BIN" --exclusive --close --wait "$HUBI_LOCK_TIMEOUT" \
        --conflict-exit-code 75 "$lock_file" \
        env -u HUBI_ACTIVE bash "$HUBI_SCRIPT_PATH" __start-locked \
        "$agent" "$canonical_path" "$expected_repo_id" "$instance" "$hash" "$watch_fifo" \
        "$executable" "${arguments[@]}" >"$tmp_out" 2>&1 {watch_write_fd}<&- &
    worker_pid=$!
    STARTUP_WORKER_PID="$worker_pid"
    STARTUP_IDENTITY_HASH="$hash"
    wait "$worker_pid"
    rc=$?
    STARTUP_WORKER_PID=""
    STARTUP_IDENTITY_HASH=""
    STARTUP_WATCH_FIFO=""
    if [[ -n "$watch_write_fd" ]]; then
        # See the NOTE above: no trailing 2>/dev/null on a bare exec.
        exec {watch_write_fd}<&- || true
    fi
    [[ -z "$watch_fifo" ]] || rm -f -- "$watch_fifo" 2>/dev/null || true
    output="$(cat -- "$tmp_out" 2>/dev/null)"
    rm -f -- "$tmp_out"

    if (( rc == 75 )); then
        printf 'Hubi: limit %ss oczekiwania na blokadę startu (startup lock) %s/%s został przekroczony.\n' \
            "$HUBI_LOCK_TIMEOUT" "$agent/$instance" "$canonical_path" >&2
        return 1
    fi
    if (( rc != 0 )); then
        printf 'Hubi: start %s/%s/%s pod blokadą nie powiódł się (rc=%d).\n' "$agent" "$instance" "$canonical_path" "$rc" >&2
        [[ -z "$output" ]] || printf '%s\n' "$output" >&2
        return "$rc"
    fi
    ENSURED_SESSION="$(agent_session_name "$agent" "$canonical_path" "$instance")"
}

# Rolls a STARTING record back toward ABSENT: kills the bootstrap tmux
# session (only if its live @hubi-token matches, never by name alone),
# terminates any scope it created the same way, then removes the record —
# but ONLY once every resource whose ownership depends on that record has
# been confirmed absent. If cleanup cannot be authoritatively completed
# (a kill/terminate call itself fails, or scope state can't be confirmed),
# the record is deliberately preserved as diagnostic/ownership evidence for
# later reconciliation instead of being deleted out from under a possibly
# still-live resource. Returns 0 if fully clean (record gone or never
# existed), 1 if cleanup was incomplete (record preserved).
rollback_starting_record() {
    local hash="$1" session scope token live_token ok=1 scope_rc
    load_state_record "$hash" || return 0
    [[ "${REC[state]}" == STARTING ]] || return 0
    session="${REC[session]}"
    scope="${REC[scope]}"
    token="${REC[token]}"
    if tmux_cmd has-session -t "$session" 2>/dev/null; then
        live_token="$(tmux_cmd show-option -qv -t "$session" @hubi-token 2>/dev/null || true)"
        if [[ "$live_token" == "$token" ]]; then
            tmux_cmd kill-session -t "$session" >/dev/null 2>&1 || ok=0
        else
            # A live session exists at the expected name but does not carry
            # our token: this is not "nothing to clean", it is an ownership
            # conflict. Never kill it, and never treat this as successful
            # cleanup — the record must stay as evidence (P2-04).
            printf 'Hubi: sesja %s przy wycofywaniu nie ma zweryfikowanego tokenu (CONFLICT); pozostawiono bez zmian.\n' "$session" >&2
            ok=0
        fi
    fi
    if [[ -n "$scope" ]]; then
        terminate_scope "$scope" "$token"; scope_rc=$?
        (( scope_rc == 0 )) || ok=0
    fi
    if (( ok )); then
        delete_state_record "$hash"
        return 0
    fi
    printf 'Hubi: nie można w pełni wycofać przerwanego startu %s; zaufany rekord zachowany do rekoncyliacji.\n' "$hash" >&2
    return 1
}

reconcile_leftover_starting() { rollback_starting_record "$1"; }

# Same evidence-preservation contract as rollback_starting_record, for the
# bootstrap failure paths inside ensure_agent_session_locked below (called
# with a session Hubi just created itself in this exact invocation, so no
# token check is needed for the session half — ownership is not in question,
# only whether cleanup actually completed).
rollback_bootstrap() {
    local hash="$1" session="$2" scope="$3" token="$4" ok=1 scope_rc
    if [[ -n "$session" ]]; then
        tmux_cmd kill-session -t "$session" >/dev/null 2>&1 || ok=0
    fi
    if [[ -n "$scope" ]]; then
        terminate_scope "$scope" "$token"; scope_rc=$?
        (( scope_rc == 0 )) || ok=0
    fi
    if (( ok )); then
        delete_state_record "$hash"
        return 0
    fi
    printf 'Hubi: nie można w pełni wycofać nieudanego startu %s; zaufany rekord zachowany do rekoncyliacji.\n' "$hash" >&2
    return 1
}

# Spawns a background watchdog (inside the worker itself) that blocks on the
# parent-death FIFO and, upon EOF — the launcher is gone for any reason,
# including an uncatchable SIGKILL that no trap could ever see — stops this
# worker so it cannot go on to create/commit anything further, then rolls
# back ONLY through a trusted record:
#
#   - a trusted STARTING record, if one already exists, is the authoritative
#     source and is rolled back exactly as rollback_starting_record already
#     does (token-verified);
#   - a COMMITTED record (the worker finished normally moments earlier) is
#     left completely alone;
#   - if NO record exists at all yet, nothing is cleaned by name. Holding
#     the identity's own flock only serializes Hubi's own participants —
#     it proves nothing about an unrelated or manual process, which never
#     acquires that lock, appearing at the same deterministic name in the
#     meantime. Absent a trusted record there is no ownership evidence, and
#     "no trusted record => no destructive action" has no exception: the
#     worker being stopped is what prevents it from finishing the bootstrap
#     unsupervised; nothing further is destroyed on its behalf.
start_parent_death_watchdog() {
    local hash="$1" fifo="$2" worker_pid="$$"
    (
        IFS= read -r _ <"$fifo" 2>/dev/null
        kill -TERM "$worker_pid" 2>/dev/null || true
        local waited=0
        while (( waited < 20 )) && kill -0 "$worker_pid" 2>/dev/null; do sleep 0.1; ((waited += 1)); done
        kill -KILL "$worker_pid" 2>/dev/null || true

        if load_state_record "$hash" && [[ "${REC[state]}" == STARTING ]]; then
            rollback_starting_record "$hash" >/dev/null 2>&1 || true
        fi
    ) &
}

# The actual bootstrap (runs as the supervised worker, under the identity
# flock). Transactional: from the moment the tmux bootstrap object exists,
# every failure path either fully rolls back to ABSENT or reaches a single
# COMMIT point. The one intentional exception is a fast-crashing agent after
# respawn-pane succeeds — that is a legitimate EXITED object, not a failed
# transaction, and is committed before the crash is even detected.
ensure_agent_session_locked() {
    local agent="$1" canonical_path="$2" expected_repo_id="$3" instance="$4" identity_hash="$5" watch_fifo="$6" executable="$7"
    shift 7
    local -a arguments=("$@")
    local hash session scope pane output token created_ts st

    validate_instance_name "$instance" || return 2
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    if [[ "$hash" != "$identity_hash" ]]; then
        printf 'Hubi: niezgodność skrótu tożsamości; odmowa startu.\n' >&2
        return 1
    fi
    session="$(agent_session_name "$agent" "$canonical_path" "$instance")"
    scope="$(agent_scope_name "$agent" "$canonical_path" "$instance")"

    reconcile_leftover_starting "$hash"

    if tmux_cmd has-session -t "$session" 2>/dev/null; then
        if load_state_record "$hash" && [[ "${REC[state]}" == COMMITTED ]] \
            && verify_record_live_session "$agent" "$instance" && [[ "${REC[session]}" == "$session" ]]; then
            return 0
        fi
        printf 'Hubi: sesja %s istnieje bez zweryfikowanej własności v4; odmowa przejęcia (CONFLICT).\n' "$session" >&2
        return 1
    fi

    scope_state "$scope"; st=$?
    if (( st == 0 )); then
        if load_state_record "$hash" && verify_scope_description_token "$scope" "${REC[token]}"; then
            printf 'Hubi: znaleziono zweryfikowany osierocony scope %s; bezpieczne czyszczenie przed restartem.\n' "$scope" >&2
            terminate_scope "$scope" "${REC[token]}" || return 1
            delete_state_record "$hash"
        else
            printf 'Hubi: scope %s jest aktywny bez zweryfikowanej własności; odmowa przejęcia (CONFLICT).\n' "$scope" >&2
            return 1
        fi
    elif (( st == 2 )); then
        printf 'Hubi: nie można ustalić stanu scope %s (błąd systemctl); odmowa startu (fail-closed).\n' "$scope" >&2
        return 1
    fi

    revalidate_repo_for_start "$canonical_path" "$expected_repo_id" || return 1

    # From here on we are about to create a bootstrap object. Arm the
    # parent-death watchdog first: a launcher that vanishes for ANY reason
    # from this point on — including an uncatchable SIGKILL, which
    # cancel_startup_worker's trap cannot help with at all — must not leave
    # this attempt to finish unsupervised (P2-05). The launcher only ever
    # invokes this worker with a working watchdog FIFO (P2-03: setup is a
    # mandatory startup precondition, checked before the worker is even
    # spawned) — a missing one here means that guarantee was somehow
    # violated, so this fails closed too rather than proceed unsupervised.
    if [[ -z "$watch_fifo" ]]; then
        printf 'Hubi: brak FIFO obserwatora startu (watchdog); odmowa startu (fail-closed).\n' >&2
        return 1
    fi
    start_parent_death_watchdog "$hash" "$watch_fifo"

    token="$(random_token)"
    if ! output="$(tmux_cmd new-session -d -P -F '#{pane_id}' -s "$session" -c "$canonical_path" -- sleep 30 2>&1)"; then
        printf 'Hubi: tmux nie utworzył sesji %s:\n%s\n' "$session" "$output" >&2
        return 1
    fi
    pane="$output"
    if [[ "$pane" != %* ]]; then
        printf 'Hubi: tmux nie zwrócił identyfikatora panelu agenta: %s\n' "$pane" >&2
        tmux_cmd kill-session -t "$session" >/dev/null 2>&1 || true
        return 1
    fi

    created_ts="$(date +%s)"
    if ! write_state_record "$hash" \
        "identity_version=$HUBI_IDENTITY_VERSION" "agent=$agent" "instance=$instance" \
        "canonical_path=$canonical_path" "repo_dev_inode=$expected_repo_id" \
        "session=$session" "pane=$pane" "scope=$scope" "token=$token" \
        "state=STARTING" "created=$created_ts" "committed=0"; then
        printf 'Hubi: nie można utworzyć zaufanego rekordu startu; wycofywanie.\n' >&2
        tmux_cmd kill-session -t "$session" >/dev/null 2>&1 || true
        return 1
    fi

    if [[ "$(tmux_cmd display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)" != "$canonical_path" ]]; then
        printf 'Hubi: tmux nie zachował katalogu repozytorium %s; start został przerwany.\n' "$canonical_path" >&2
        rollback_bootstrap "$hash" "$session" "" "$token"
        return 1
    fi

    sanitize_tmux_environment
    if [[ "$(tmux_cmd show-environment -g HUBI_ACTIVE 2>/dev/null || true)" == HUBI_ACTIVE=* ]]; then
        printf 'Hubi: nie udało się usunąć HUBI_ACTIVE ze środowiska tmux; wycofywanie.\n' >&2
        rollback_bootstrap "$hash" "$session" "" "$token"
        return 1
    fi

    if ! tmux_cmd set-option -t "$session" @hubi-managed v4 \
        || ! tmux_cmd set-option -t "$session" @hubi-identity-version "$HUBI_IDENTITY_VERSION" \
        || ! tmux_cmd set-option -t "$session" @hubi-agent "$agent" \
        || ! tmux_cmd set-option -t "$session" @hubi-repo-canon "$canonical_path" \
        || ! tmux_cmd set-option -t "$session" @hubi-instance "$instance" \
        || ! tmux_cmd set-option -t "$session" @hubi-scope "$scope" \
        || ! tmux_cmd set-option -t "$session" @hubi-pane "$pane" \
        || ! tmux_cmd set-option -t "$session" @hubi-token "$token" \
        || ! tmux_cmd set-window-option -t "$pane" remain-on-exit on \
        || ! tmux_cmd set-window-option -t "$pane" window-size largest; then
        printf 'Hubi: nie udało się utrwalić metadanych/ustawień sesji %s.\n' "$session" >&2
        rollback_bootstrap "$hash" "$session" "" "$token"
        return 1
    fi
    if ! tmux_cmd set-hook -t "$session" after-new-window \
        'set-window-option remain-on-exit on; set-window-option window-size largest'; then
        printf 'Hubi: nie udało się ustawić polityki nowych okien sesji %s.\n' "$session" >&2
        rollback_bootstrap "$hash" "$session" "" "$token"
        return 1
    fi

    if ! revalidate_repo_for_start "$canonical_path" "$expected_repo_id"; then
        printf 'Hubi: repozytorium zmieniło się przed utworzeniem scope; wycofywanie sesji startowej %s.\n' "$session" >&2
        rollback_bootstrap "$hash" "$session" "" "$token"
        return 1
    fi

    if ! output="$(tmux_cmd respawn-pane -k -t "$pane" -- \
        "$SYSTEMD_RUN_BIN" --user --scope --quiet --collect --unit="$scope" \
        --description="hubi-owned:$token" -- \
        "$executable" "${arguments[@]}" 2>&1)"; then
        printf 'Hubi: nie można uruchomić agenta w sesji %s:\n%s\n' "$session" "$output" >&2
        rollback_bootstrap "$hash" "$session" "$scope" "$token"
        return 1
    fi

    # respawn-pane succeeded: the agent has been handed off into its scope.
    # From here the object is fully valid even if it exits immediately, so it
    # is committed before the quick-crash poll below (P2-02: a failed
    # respawn-pane above is a startup failure and rolls back; an agent that
    # started and then exited is a legitimate EXITED object, not a rollback).
    if ! write_state_record "$hash" \
        "identity_version=$HUBI_IDENTITY_VERSION" "agent=$agent" "instance=$instance" \
        "canonical_path=$canonical_path" "repo_dev_inode=$expected_repo_id" \
        "session=$session" "pane=$pane" "scope=$scope" "token=$token" \
        "state=COMMITTED" "created=$created_ts" "committed=$(date +%s)"; then
        printf 'Hubi: nie można zatwierdzić zaufanego rekordu; wycofywanie.\n' >&2
        rollback_bootstrap "$hash" "$session" "$scope" "$token"
        return 1
    fi

    for _ in {1..10}; do
        if session_is_dead "$session"; then
            printf 'Hubi: agent zakończył się podczas startu. Ostatnie wyjście:\n' >&2
            capture_session_output "$session" >&2
            return 1
        fi
        sleep 0.05
    done
}

start_agent() {
    local agent="$1" repo_argument="$2" instance="${3:-primary}" launch_mode="${4:-new}" executable
    local -a arguments=()
    validate_instance_name "$instance" || { pause_for_ack; return 2; }
    if [[ "$launch_mode" != "new" && "$launch_mode" != "resume" ]]; then
        printf 'Hubi: nieprawidłowy tryb uruchomienia: %s\n' "$launch_mode" >&2
        return 2
    fi
    resolve_repo "$repo_argument" || { pause_for_ack; return 2; }

    # Existing RUNNING/ATTACHED/EXITED sessions remain inspectable even if the
    # agent executable was subsequently moved or removed.
    local find_rc
    find_agent_session "$agent" "$RESOLVED_REPO_DIR" "$instance"; find_rc=$?
    if (( find_rc == 3 )); then
        printf '\n  UWAGA: %s wygląda na sesję %s bez zweryfikowanej własności (CONFLICT).\n' "$FOUND_SESSION" "$agent" >&2
        printf '  Hubi nie podłącza się do niej automatycznie ani jej nie modyfikuje.\n' >&2
        pause_for_ack
        return 1
    fi
    if (( find_rc == 4 )); then
        printf '\n  Start tej instancji jest już w toku (STARTING); spróbuj ponownie za chwilę.\n' >&2
        pause_for_ack
        return 1
    fi
    if (( find_rc == 0 )); then
        attach_session "$FOUND_SESSION"
        return $?
    fi

    case "$agent" in
        codex) executable="$CODEX_BIN"; [[ "$launch_mode" == "resume" ]] && arguments=(resume) ;;
        claude)
            executable="$CLAUDE_BIN"; arguments=(--permission-mode bypassPermissions)
            [[ "$launch_mode" == "resume" ]] && arguments+=(--resume)
            ;;
        *) printf 'Hubi: nieznany agent: %s\n' "$agent" >&2; return 2 ;;
    esac
    if [[ -z "$executable" || ! -x "$executable" ]]; then
        printf 'Hubi: nie znaleziono programu %s.\n' "$agent" >&2
        pause_for_ack
        return 1
    fi
    if ! ensure_agent_instance_session "$agent" "$RESOLVED_REPO_DIR" \
        "$instance" "$executable" "${arguments[@]}"; then
        printf '\n  Start agenta nie powiódł się; sesja EXITED zachowuje diagnostykę, jeśli powstała.\n' >&2
        pause_for_ack
        return 1
    fi
    attach_session "$ENSURED_SESSION"
}

# ---------------------------------------------------------------------------
# Tri-state systemctl (P1-03): scope_state never conflates "confirmed
# inactive" with "the query itself failed." Callers that mutate or claim
# success on the strength of scope state must fail closed on state 2.
#   returns/sets via $? : 0 active, 1 inactive (confirmed), 2 error/unknown
# ---------------------------------------------------------------------------
# Queries systemd directly for ActiveState (and, for the "failed" case only,
# TasksCurrent) rather than trusting the single-word "systemctl is-active"
# shorthand. A multi-property "show" reply is parsed by KEY=VALUE, never by
# line position — a real systemd was observed to reorder properties relative
# to the order they were requested in, so positional parsing is unsafe.
#
#   active/reloading/activating/deactivating => 0 (not confirmed inactive:
#     activating/deactivating are still transitioning, never treated as gone)
#   inactive/dead                            => 1 (confirmed inactive)
#   failed with TasksCurrent==0               => 1 (confirmed empty cgroup)
#   failed with TasksCurrent>0 or unknown      => 0 / 2 (never assumed empty:
#     "failed" is not automatically equivalent to nonexistent — its cgroup
#     may still hold processes)
#   query/D-Bus failure or unparseable reply  => 2 (error/unknown)
scope_state() {
    local scope="$1" out rc key value
    local active_state="" tasks_current=""
    out="$("$SYSTEMCTL_BIN" --user show -p ActiveState -p TasksCurrent -- "$scope" 2>/dev/null)"
    rc=$?
    if (( rc != 0 )) || [[ -z "$out" ]]; then
        return 2
    fi
    while IFS='=' read -r key value; do
        case "$key" in
            ActiveState) active_state="$value" ;;
            TasksCurrent) tasks_current="$value" ;;
        esac
    done <<<"$out"
    case "$active_state" in
        active|reloading|activating|deactivating) return 0 ;;
        inactive|dead) return 1 ;;
        failed)
            if [[ "$tasks_current" =~ ^[0-9]+$ ]]; then
                (( tasks_current > 0 )) && return 0
                return 1
            fi
            return 2
            ;;
        *) return 2 ;;
    esac
}

scope_is_active() { scope_state "$1"; }

require_scope_kill_capability() {
    local help
    help="$("$SYSTEMCTL_BIN" kill --help 2>&1 || true)"
    if [[ "$help" != *"--kill-whom=WHOM"* || "$help" != *"--signal=SIGNAL"* ]]; then
        printf 'Hubi: ten systemctl nie obsługuje wymaganego zabijania pełnego cgroup (--kill-whom=all).\n' >&2
        return 1
    fi
}

signal_scope() {
    local scope="$1" signal="$2" output st
    require_scope_kill_capability || return 1
    if ! output="$("$SYSTEMCTL_BIN" --user kill --kill-whom=all --signal="$signal" -- "$scope" 2>&1)"; then
        scope_state "$scope"; st=$?
        if (( st == 0 )); then
            printf 'Hubi: systemctl nie wysłał %s do pełnego scope %s:\n%s\n' "$signal" "$scope" "$output" >&2
            return 1
        elif (( st == 2 )); then
            printf 'Hubi: nie można potwierdzić wysłania %s do scope %s (błąd systemctl):\n%s\n' "$signal" "$scope" "$output" >&2
            return 1
        fi
    fi
}

# 0 confirmed inactive, 1 timed out (still active), 2 error/unknown.
wait_scope_inactive() {
    local scope="$1" attempts="$2" i st
    for ((i = 0; i < attempts; i++)); do
        scope_state "$scope"; st=$?
        (( st == 1 )) && return 0
        (( st == 2 )) && return 2
        sleep 0.1
    done
    return 1
}

# Terminates a scope, never claiming success on an ambiguous systemctl
# result (P1-03). When a token is supplied, the scope's own Description must
# vouch for it before Hubi will touch it at all (P2-04); pass "" only when
# the caller has already independently established ownership by other means.
# Returns: 0 confirmed terminated, 1 still active (failed), 2 unknown/error.
terminate_scope() {
    local scope="$1" token="${2:-}" st
    scope_state "$scope"; st=$?
    (( st == 1 )) && return 0
    if (( st == 2 )); then
        printf 'Hubi: nie można ustalić stanu scope %s (błąd systemctl); odmowa działania (fail-closed).\n' "$scope" >&2
        return 2
    fi
    if [[ -n "$token" ]] && ! verify_scope_description_token "$scope" "$token"; then
        printf 'Hubi: scope %s nie ma zweryfikowanego znacznika własności; odmowa zakończenia.\n' "$scope" >&2
        return 2
    fi
    signal_scope "$scope" TERM || return 1
    wait_scope_inactive "$scope" 20; st=$?
    (( st == 0 )) && return 0
    if (( st == 2 )); then
        printf 'Hubi: stan scope %s po TERM jest nieznany (błąd systemctl); zachowuję diagnostykę.\n' "$scope" >&2
        return 2
    fi
    signal_scope "$scope" KILL || return 1
    wait_scope_inactive "$scope" 20; st=$?
    case "$st" in
        0) return 0 ;;
        2) printf 'Hubi: stan scope %s po KILL jest nieznany (błąd systemctl); zachowuję diagnostykę.\n' "$scope" >&2; return 2 ;;
        *) printf 'Hubi: scope %s nadal jest aktywny po TERM/KILL.\n' "$scope" >&2; return 1 ;;
    esac
}

stop_agent_now() {
    local agent="$1" canonical_path="$2" instance="${3:-primary}" hash rc
    validate_instance_name "$instance" || return 2
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
    run_under_identity_lock "$hash" "$HUBI_LOCK_TIMEOUT"; rc=$?
    if (( rc == 75 )); then
        printf 'Hubi: limit %ss oczekiwania na blokadę cyklu życia (stop) został przekroczony.\n' "$HUBI_LOCK_TIMEOUT" >&2
        return 1
    elif (( rc != 0 )); then
        printf 'Hubi: nie można otworzyć blokady cyklu życia.\n' >&2
        return 1
    fi
    stop_agent_now_body "$agent" "$canonical_path" "$instance"
    rc=$?
    release_identity_lock
    return "$rc"
}

stop_agent_now_body() {
    local agent="$1" canonical_path="$2" instance="$3" hash scope session token find_rc st rc
    hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"

    find_agent_session "$agent" "$canonical_path" "$instance"; find_rc=$?
    if (( find_rc == 3 )); then
        printf 'Hubi: %s wygląda na sesję %s bez zweryfikowanej własności (CONFLICT); odmowa działania.\n' "$FOUND_SESSION" "$agent" >&2
        return 1
    fi
    if (( find_rc == 4 )); then
        printf 'Hubi: start jest w toku (STARTING); poczekaj na jego zakończenie przed zatrzymaniem.\n' >&2
        return 1
    fi
    if (( find_rc != 0 )); then
        if load_state_record "$hash" && [[ "${REC[state]}" == COMMITTED ]]; then
            scope="${REC[scope]}"
            scope_state "$scope"; st=$?
            if (( st == 0 )); then
                printf 'Hubi: czyszczenie zweryfikowanego osieroconego scope %s (brak sesji tmux).\n' "$scope" >&2
                terminate_scope "$scope" "${REC[token]}"; rc=$?
                (( rc == 0 )) && delete_state_record "$hash"
                return "$rc"
            elif (( st == 2 )); then
                printf 'Hubi: nie można ustalić stanu scope %s (błąd systemctl); odmowa działania (fail-closed).\n' "$scope" >&2
                return 1
            fi
            delete_state_record "$hash"
        fi
        printf 'Hubi: %s dla %s nie działa.\n' "$agent" "$canonical_path" >&2
        return 1
    fi

    session="$FOUND_SESSION"

    token=""
    scope="$(agent_scope_name "$agent" "$canonical_path" "$instance")"
    if load_state_record "$hash"; then
        token="${REC[token]}"
        scope="${REC[scope]}"
    fi
    if ! session_is_dead "$session"; then
        if agent_pane "$session"; then
            tmux_cmd send-keys -t "$FOUND_PANE" C-c >/dev/null 2>&1 || true
        fi
        wait_scope_inactive "$scope" 30 || true
    fi
    terminate_scope "$scope" "$token"; rc=$?
    if (( rc != 0 )); then
        return 1
    fi
    if ! tmux_cmd kill-session -t "$session"; then
        printf 'Hubi: agent zatrzymany, ale nie udało się usunąć sesji tmux %s.\n' "$session" >&2
        return 1
    fi
    delete_state_record "$hash"
}

kill_agent() {
    local agent="$1" canonical_path="$2" instance="${3:-primary}" choice find_rc hash
    validate_instance_name "$instance" || return 2
    find_agent_session "$agent" "$canonical_path" "$instance"; find_rc=$?
    if (( find_rc == 3 )); then
        printf '\n  UWAGA: znaleziono obiekt o pasującej nazwie bez zweryfikowanej własności (CONFLICT).\n'
        printf '  Hubi nie modyfikuje go automatycznie.\n'
        pause_for_ack
        return 1
    fi
    if (( find_rc == 4 )); then
        printf '\n  Start jest w toku (STARTING); spróbuj ponownie po jego zakończeniu.\n'
        pause_for_ack
        return 1
    fi
    if (( find_rc != 0 )); then
        hash="$(compute_identity_hash "$canonical_path" "$agent" "$instance")"
        if ! load_state_record "$hash" || [[ "${REC[state]:-}" != COMMITTED ]]; then
            printf '\n  %s dla %s nie działa.\n' "$agent" "$canonical_path"
            pause_for_ack
            return 0
        fi
        printf '\n  Wykryto zweryfikowany ORPHANED scope bez sesji tmux.\n'
    fi
    printf '\n  Zakończyć %s/%s i cały jego scope procesów?\n' "$agent" "$instance"
    printf '  [y] Tak\n  [n] Nie\n  > '
    if ! read_choice choice; then return 0; fi
    case "$choice" in
        y|Y) if ! stop_agent_now "$agent" "$canonical_path" "$instance"; then pause_for_ack; return 1; fi ;;
        n|N) ;;
        *) printf '  Anulowano: nieznany wybór.\n'; pause_for_ack ;;
    esac
}

project_shell() {
    resolve_repo "$1" || { pause_for_ack; return 2; }
    clear_screen
    printf '\n  Shell projektu: %s\n' "$RESOLVED_REPO_KEY"
    printf '  Tymczasowy shell. Procesy nie są zarządzane przez Hubi i mogą zakończyć się po rozłączeniu SSH.\n'
    printf '  Użyj zarządzanych sesji Claude/Codex dla trwałych agentów.\n  Powrót do menu: exit\n\n'
    (cd "$RESOLVED_REPO_DIR" || exit 1; bash)
    enable_safe_input
    discard_queued_input
    clear_screen
}

normal_shell() {
