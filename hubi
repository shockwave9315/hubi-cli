show_git_status() {
    clear_screen
    printf '\n  GIT — %s\n  ──────────────────────────────────\n\n' "$2"
    git -C "$1" status -sb
    printf '\n'
    git -C "$1" log -5 --oneline --decorate 2>/dev/null || true
    pause_for_ack
}

sessions_menu() {
    local page=0 page_size=9 pages start end i index choice session clients status
    local -a sessions=()
    while true; do
        clear_screen
        mapfile -t sessions < <(tmux_cmd list-sessions -F '#S' 2>/dev/null | sort || true)
        if (( ${#sessions[@]} == 0 )); then
            printf '\n  HUBINET DEVBOX — SESJE\n  ──────────────────────────────────\n\n  Brak aktywnych sesji.\n'
            pause_for_ack
            return
        fi
        pages=$(( (${#sessions[@]} + page_size - 1) / page_size ))
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size))
        (( end > ${#sessions[@]} )) && end=${#sessions[@]}
        printf '\n  HUBINET DEVBOX — SESJE (strona %d/%d)\n  ──────────────────────────────────\n\n' "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            session="${sessions[$i]}"
            clients="$(session_clients "$session")"
            status="$(session_status "$session")"
            printf '  [%d] %-32s %s; klienci: %s\n' "$((i - start + 1))" "$session" "$status" "$clients"
        done
        printf '\n  [n] Następna  [p] Poprzednia  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            b|B) return ;;
            n|N) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            p|P) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            [1-9]) index=$((start + choice - 1)); if (( index < end )); then attach_session "${sessions[$index]}" || true; else unknown_key; fi ;;
            *) unknown_key ;;
        esac
    done
}

instance_list() {
    local repo_key="$1" agent session managed stored_agent stored_repo instance
    local -A found
    for agent in codex claude; do
        printf '%s|primary\n' "$agent"
        found=()
        while IFS= read -r session; do
            [[ -n "$session" ]] || continue
            managed="$(tmux_cmd show-option -qv -t "=$session:" @hubi-managed 2>/dev/null || true)"
            stored_agent="$(tmux_cmd show-option -qv -t "=$session:" @hubi-agent 2>/dev/null || true)"
            stored_repo="$(tmux_cmd show-option -qv -t "=$session:" @hubi-repo 2>/dev/null || true)"
            instance="$(tmux_cmd show-option -qv -t "=$session:" @hubi-instance 2>/dev/null || true)"
            if [[ "$managed" == "v5" && "$stored_agent" == "$agent" && "$stored_repo" == "$repo_key" \
                && "$instance" != "primary" ]] && validate_instance_name "$instance"; then
                printf '%s|%s\n' "$agent" "$instance"
                found["$instance"]=1
            fi
        done < <(tmux_cmd list-sessions -F '#S' 2>/dev/null | sort || true)
        # A secondary instance whose tmux session is gone but whose exact
        # scope is still active has no tmux metadata to read; recover it
        # directly from the (already unique) scope name instead so it stays
        # visible as ORPHANED rather than silently disappearing.
        while IFS= read -r instance; do
            [[ -n "$instance" && -z "${found[$instance]:-}" ]] || continue
            printf '%s|%s\n' "$agent" "$instance"
            found["$instance"]=1
        done < <(secondary_scope_instances "$agent" "$repo_key" | sort -u)
    done
}

instance_menu() {
    local agent="$1" repo_key="$2" instance="$3" choice state label
    case "$agent" in codex) label="Codex" ;; claude) label="Claude" ;; esac
    while true; do
        clear_screen
        state="$(agent_status "$agent" "$repo_key" "$instance")"
        printf '\n  INSTANCJA — %s / %s\n  ──────────────────────────────────\n\n' "$label" "$instance"
        printf '  Projekt: %s\n  Status:  %s\n\n' "$repo_key" "$state"
        show_hint
        if find_agent_session "$agent" "$repo_key" "$instance"; then
            printf '  [a] Podłącz / zobacz EXITED\n'
        else
            printf '  [n] Nowa rozmowa\n'
            printf '  [r] Wznów istniejącą rozmowę\n'
        fi
        # Always offered, like the primary agent's [c]/[a] in project_menu:
        # kill_agent() already handles "not running", running, EXITED and an
        # orphaned scope without a tmux session on its own.
        printf '  [x] Zakończ instancję (także EXITED/ORPHANED)\n'
        printf '  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            a|A) if find_agent_session "$agent" "$repo_key" "$instance"; then start_agent "$agent" "$repo_key" "$instance" || true; else unknown_key; fi ;;
            x|X) kill_agent "$agent" "$repo_key" "$instance" || true ;;
            n|N) if ! find_agent_session "$agent" "$repo_key" "$instance"; then start_agent "$agent" "$repo_key" "$instance" new || true; else unknown_key; fi ;;
            r|R) if ! find_agent_session "$agent" "$repo_key" "$instance"; then start_agent "$agent" "$repo_key" "$instance" resume || true; else unknown_key; fi ;;
            b|B) return ;;
            *) unknown_key ;;
        esac
    done
}

instances_menu() {
    local repo_key="$1" page=0 page_size=9 pages start end i index choice entry agent instance label
    local -a entries=()
    while true; do
        clear_screen
        mapfile -t entries < <(instance_list "$repo_key")
        pages=$(( (${#entries[@]} + page_size - 1) / page_size )); (( pages == 0 )) && pages=1
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size)); (( end > ${#entries[@]} )) && end=${#entries[@]}
        printf '\n  INSTANCJE — %s (strona %d/%d)\n  ──────────────────────────────────\n\n' \
            "$repo_key" "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            entry="${entries[$i]}"; agent="${entry%%|*}"; instance="${entry#*|}"
            case "$agent" in codex) label="Codex" ;; claude) label="Claude" ;; esac
            printf '  [%d] %-7s %-32s %s\n' "$((i - start + 1))" "$label" "$instance" \
                "$(agent_status "$agent" "$repo_key" "$instance")"
        done
        printf '\n  [c] Nowa instancja Codex  [a] Nowa instancja Claude\n'
        printf '  [n] Następna  [p] Poprzednia  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            b|B) return ;;
            n|N) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            p|P) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            c|C|a|A)
                if [[ "$choice" == "c" || "$choice" == "C" ]]; then agent="codex"; else agent="claude"; fi
                printf '\n  Nazwa instancji (litery, cyfry, _ lub -, maks. 32): '
                if ! read_choice instance; then return; fi
                if validate_instance_name "$instance"; then
                    instance_menu "$agent" "$repo_key" "$instance"
                else
                    MENU_HINT="Nieprawidłowa nazwa instancji."
                fi
                ;;
            [1-9])
                index=$((start + choice - 1))
                if (( index < end )); then
                    entry="${entries[$index]}"; agent="${entry%%|*}"; instance="${entry#*|}"
                    instance_menu "$agent" "$repo_key" "$instance"
                else
                    unknown_key
                fi
                ;;
            *) unknown_key ;;
        esac
    done
}

project_menu() {
    local repo_key="$1" directory="$2" choice git_state codex_state claude_state
    while true; do
        clear_screen
        git_state="$(git_summary "$directory")"
        codex_state="$(agent_status codex "$repo_key")"
        claude_state="$(agent_status claude "$repo_key")"
        printf '\n  ╭────────────────────────────────────────╮\n  │          HUBINET DEVBOX — v%s          │\n  ╰────────────────────────────────────────╯\n\n' "$HUBI_VERSION"
        printf '  Projekt: %s\n  Git:     %s\n' "$repo_key" "$git_state"
        printf '  Codex:   %s\n  Claude:  %s\n\n' "$codex_state" "$claude_state"
        show_hint
        printf '  [1] Codex primary  — uruchom / podłącz / zobacz EXITED\n'
        printf '  [2] Claude primary — uruchom / podłącz / zobacz EXITED\n'
        printf '  [i] Instancje\n'
        printf '  [t] Terminale persistent\n'
        printf '  [3] Shell projektu\n  [g] Git status\n'
        printf '  [c] Zakończ Codexa (także EXITED)\n  [a] Zakończ Claude (także EXITED)\n  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            1) start_agent codex "$repo_key" || true ;;
            2) start_agent claude "$repo_key" || true ;;
            i|I) instances_menu "$repo_key" ;;
            t|T) terminals_menu "$repo_key" ;;
            3) project_shell "$repo_key" || true ;;
            g|G) show_git_status "$directory" "$repo_key" ;;
            c|C) kill_agent codex "$repo_key" || true ;;
            a|A) kill_agent claude "$repo_key" || true ;;
            b|B) return ;;
            *) unknown_key ;;
        esac
    done
}

main_menu() {
    local page=0 page_size=9 pages start end i index choice repo
    local host_name user_name session_total codex_state claude_state
    local -a repos=()
    if [[ -n "${TMUX:-}" ]]; then
        printf 'Hubi: menu działa wyłącznie poza tmuxem. Odłącz sesję i spróbuj ponownie.\n' >&2
        return 1
    fi
    while true; do
        clear_screen
        mapfile -t repos < <(repo_list)
        pages=$(( (${#repos[@]} + page_size - 1) / page_size )); (( pages == 0 )) && pages=1
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size)); (( end > ${#repos[@]} )) && end=${#repos[@]}
        host_name="$(hostname)"
        user_name="$(whoami)"
        session_total="$(session_count)"
        printf '\n  ╭────────────────────────────────────────╮\n  │          HUBINET DEVBOX — v%s          │\n  ╰────────────────────────────────────────╯\n\n' "$HUBI_VERSION"
        printf '  Host:     %s\n  User:     %s\n  Sesje:    %s\n  Projekty (strona %d/%d):\n\n' \
            "$host_name" "$user_name" "$session_total" "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            repo="${repos[$i]}"
            codex_state="$(agent_status codex "$repo")"
            claude_state="$(agent_status claude "$repo")"
            printf '  [%d] %-20s C:%-18s A:%s\n' "$((i - start + 1))" "$repo" \
                "$codex_state" "$claude_state"
        done
        if (( ${#repos[@]} == 0 )); then printf '  Nie znaleziono repozytoriów Git pod %s.\n' "$REPOS_ROOT"; fi
        printf '\n  [n] Następna  [p] Poprzednia  [s] Sesje\n  [h] Shell  [q] Zwykły prompt  [x] Wyloguj\n  > '
        if ! read_choice choice; then return 0; fi
        case "$choice" in
            s|S) sessions_menu ;;
            h|H) normal_shell ;;
            q|Q) clear_screen; return 98 ;;
            x|X) clear_screen; return 99 ;;
            n|N) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            p|P) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            [1-9])
                index=$((start + choice - 1))
                if (( index < end )); then
                    repo="${repos[$index]}"
                    if resolve_repo "$repo"; then project_menu "$RESOLVED_REPO_KEY" "$RESOLVED_REPO_DIR"; else pause_for_ack; fi
                else unknown_key; fi
                ;;
            *) unknown_key ;;
        esac
    done
}

usage() {
    printf '%s\n' 'Użycie:' '  hubi' '  hubi codex REPO [INSTANCE [new|resume]]' \
        '  hubi claude REPO [INSTANCE [new|resume]]' '  hubi shell REPO' '  hubi sessions' \
        '  hubi doctor'
}

hubi_main() {
    local command_name="${1:-menu}" rc=0
    if [[ -n "${HUBI_ACTIVE:-}" ]]; then
        printf 'Hubi: zagnieżdżone uruchomienie jest zabronione (HUBI_ACTIVE jest ustawione).\n' >&2
        return 125
    fi
    export HUBI_ACTIVE=1
    install_signal_handlers
    enable_safe_input
    case "$command_name" in
        menu) main_menu || rc=$? ;;
        codex|claude)
            if (( $# < 2 || $# > 4 )); then
                usage >&2; rc=2
            else
                start_agent "$command_name" "$2" "${3:-primary}" "${4:-new}" || rc=$?
            fi
            ;;
        shell) if (( $# != 2 )); then usage >&2; rc=2; else project_shell "$2" || rc=$?; fi ;;
        sessions) if (( $# != 1 )); then usage >&2; rc=2; else sessions_menu || rc=$?; fi ;;
        doctor) if (( $# != 1 )); then usage >&2; rc=2; else hubi_doctor || rc=$?; fi ;;
        *) usage >&2; rc=2 ;;
    esac
    return "$rc"
}

if [[ "${BASH_SOURCE[0]}" == "$0" && "${1:-}" == "__start-locked" ]]; then
    shift
    if (( $# < 6 )); then
        printf 'Hubi: niepełne argumenty wewnętrznego startu.\n' >&2
        exit 2
    fi
    ensure_agent_session_locked "$@"
    exit $?
fi

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    hubi_main "$@"
    exit $?
fi
