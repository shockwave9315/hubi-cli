}

show_git_status() {
    clear_screen
    printf '\n  GIT — %s\n  ──────────────────────────────────\n\n' "$2"
    git -C "$1" status -sb
    printf '\n'
    git -C "$1" log -5 --oneline --decorate 2>/dev/null || true
    pause_for_ack
}

sessions_menu() {
    local page=0 page_size=9 pages start end i index choice session clients status
    local -a sessions=()
    while true; do
        clear_screen
        mapfile -t sessions < <(tmux_cmd list-sessions -F '#S' 2>/dev/null | sort || true)
        if (( ${#sessions[@]} == 0 )); then
            printf '\n  HUBINET DEVBOX — SESJE\n  ──────────────────────────────────\n\n  Brak aktywnych sesji.\n'
            pause_for_ack
            return
        fi
        pages=$(( (${#sessions[@]} + page_size - 1) / page_size ))
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size))
        (( end > ${#sessions[@]} )) && end=${#sessions[@]}
        printf '\n  HUBINET DEVBOX — SESJE (strona %d/%d)\n  ──────────────────────────────────\n\n' "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            session="${sessions[$i]}"
            begin_render_critical
            clients="$(session_clients "$session")"
            end_render_critical
            begin_render_critical
            status="$(session_status "$session")"
            end_render_critical
            printf '  [%d] %-32s %s; klienci: %s\n' "$((i - start + 1))" "$session" "$status" "$clients"
        done
        printf '\n  [n] Następna  [p] Poprzednia  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            b|B) return ;;
            n|N) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            p|P) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            [1-9]) index=$((start + choice - 1)); if (( index < end )); then attach_session "${sessions[$index]}" || true; else unknown_key; fi ;;
            *) unknown_key ;;
        esac
    done
}

choose_launch_mode() {
    local agent="$1" choice
    CHOSEN_LAUNCH_MODE=""
    printf '\n  [%s] Nowa instancja\n' "${agent^}"
    printf '  [1] Rozpocznij nową rozmowę\n  [2] Wznów istniejącą rozmowę (wybór w %s)\n  [b] Powrót\n  > ' "${agent^}"
    if ! read_choice choice; then return 1; fi
    case "$choice" in
        1) CHOSEN_LAUNCH_MODE="new" ;;
        2) CHOSEN_LAUNCH_MODE="resume" ;;
        b|B) return 1 ;;
        *) printf '  Nieznany wybór; nie uruchomiono agenta.\n' >&2; return 1 ;;
    esac
}

instance_actions_menu() {
    local agent="$1" directory="$2" instance="$3" choice state mode session root repo_argument
    while true; do
        clear_screen
        begin_render_critical
        state="$(agent_status "$agent" "$directory" "$instance")"
        end_render_critical
        printf '\n  %s / %s — %s\n  ──────────────────────────────────\n\n' "${agent^}" "$instance" "$state"
        printf '  [a] Uruchom / podłącz / zobacz EXITED\n'
        printf '  [v] Przechwyć ostatnie wyjście\n  [k] Zakończ instancję\n  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            a|A)
                if find_agent_session "$agent" "$directory" "$instance"; then
                    attach_session "$FOUND_SESSION" || true
                else
                    choose_launch_mode "$agent" || { enable_safe_input; continue; }
                    mode="$CHOSEN_LAUNCH_MODE"
                    root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null || true)"
                    repo_argument="${directory#"$root"/}"
                    start_agent "$agent" "$repo_argument" "$instance" "$mode" || true
                fi
                ;;
            v|V)
                if find_agent_session "$agent" "$directory" "$instance"; then
                    session="$FOUND_SESSION"
                    clear_screen
                    printf '\n  Ostatnie wyjście — %s / %s\n  ──────────────────────────────────\n\n' "${agent^}" "$instance"
                    capture_session_output "$session"
                else
                    printf '\n  Brak sesji tmux dla %s/%s.\n' "$agent" "$instance"
                fi
                pause_for_ack
                ;;
            k|K) kill_agent "$agent" "$directory" "$instance" || true ;;
            b|B) return ;;
            *) unknown_key ;;
        esac
    done
}

agent_instances_menu() {
    local agent="$1" directory="$2" page=0 page_size=9 pages start end i index choice instance state
    local -a instances=()
    while true; do
        clear_screen
        mapfile -t instances < <(agent_instance_list "$agent" "$directory")
        pages=$(( (${#instances[@]} + page_size - 1) / page_size )); (( pages == 0 )) && pages=1
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size)); (( end > ${#instances[@]} )) && end=${#instances[@]}
        printf '\n  %s — INSTANCJE (strona %d/%d)\n  ──────────────────────────────────\n\n' \
            "${agent^}" "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            instance="${instances[$i]}"
            begin_render_critical
            state="$(agent_status "$agent" "$directory" "$instance")"
            end_render_critical
            printf '  [%d] %-20s %s\n' "$((i - start + 1))" "$instance" "$state"
        done
        printf '\n  [n] Nowa instancja  [>] Następna  [<] Poprzednia  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            n|N)
                printf '\n  Nazwa instancji: '
                if ! read_text_value instance; then return; fi
                if validate_instance_name "$instance"; then
                    instance_actions_menu "$agent" "$directory" "$instance"
                else
                    pause_for_ack
                fi
                ;;
            '>') if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            '<') if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            b|B) return ;;
            [1-9])
                index=$((start + choice - 1))
                if (( index < end )); then instance_actions_menu "$agent" "$directory" "${instances[$index]}"; else unknown_key; fi
                ;;
            *) unknown_key ;;
        esac
    done
}

manage_instances_menu() {
    local directory="$1" choice
    clear_screen
    printf '\n  ZARZĄDZANIE INSTANCJAMI\n  ──────────────────────────────────\n\n'
    printf '  [1] Codex\n  [2] Claude\n  [b] Powrót\n  > '
    if ! read_choice choice; then return; fi
    case "$choice" in
        1) agent_instances_menu codex "$directory" ;;
        2) agent_instances_menu claude "$directory" ;;
        b|B) ;;
        *) unknown_key ;;
    esac
}

print_project_instances() {
    local agent="$1" directory="$2" instance state
    printf '  %s\n' "${agent^}:"
    while IFS= read -r instance; do
        begin_render_critical
        state="$(agent_status "$agent" "$directory" "$instance")"
        end_render_critical
        printf '    %-20s %s\n' "$instance" "$state"
    done < <(agent_instance_list "$agent" "$directory")
}

# ---------------------------------------------------------------------------
# Stale/unverified managed-object reconciliation (P2-08, P3-03).
#
# Trusted records are kept independently of current repo discovery, so a
# repository that has been deleted, renamed, or moved outside HUBI_REPOS
# still has an inspectable, safely-stoppable record here — without ever
# weakening the ownership checks that gate the actual stop.
# ---------------------------------------------------------------------------
list_trusted_records() {
    local dir rec_file hash
    dir="$(state_root)" 2>/dev/null || return 0
    [[ -d "$dir" ]] || return 0
    for rec_file in "$dir"/*.rec; do
        [[ -e "$rec_file" ]] || continue
        hash="${rec_file##*/}"; hash="${hash%.rec}"
        printf '%s\n' "$hash"
    done
}

trusted_record_diagnosis() {
    local hash="$1" root repo_ok=1 session_state scope_st
    if ! load_state_record "$hash"; then
        printf 'MALFORMED'
        return
    fi
    root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null || true)"
    if [[ ! -d "${REC[canonical_path]}" ]]; then
        repo_ok=0
    elif [[ -n "$root" && "${REC[canonical_path]}"/ != "$root"/* ]]; then
        repo_ok=0
    fi
    if [[ "${REC[state]}" == STARTING ]]; then
        printf 'STARTING'
        return
    fi
    if tmux_cmd has-session -t "${REC[session]}" 2>/dev/null; then
        session_state="present"
    else
        session_state="absent"
    fi
    scope_state "${REC[scope]}"; scope_st=$?
    if (( repo_ok == 0 )); then
        if [[ "$session_state" == present || $scope_st -eq 0 ]]; then printf 'STALE-REPO'; else printf 'STALE-EMPTY'; fi
        return
    fi
    if (( scope_st == 2 )); then printf 'UNKNOWN'; return; fi
    if [[ "$session_state" == present && $scope_st -eq 0 ]]; then printf 'OK'; return; fi
    if [[ "$session_state" == present && $scope_st -ne 0 ]]; then printf 'STALE SESSION'; return; fi
    if [[ "$session_state" == absent && $scope_st -eq 0 ]]; then printf 'ORPHANED'; return; fi
    printf 'STOPPED'
}

stop_trusted_record() {
    local hash="$1" rc session scope token
    run_under_identity_lock "$hash" "$HUBI_LOCK_TIMEOUT"; rc=$?
    if (( rc != 0 )); then
        printf 'Hubi: nie można uzyskać blokady cyklu życia.\n' >&2
        return 1
    fi
    if ! load_state_record "$hash"; then
        release_identity_lock
        printf 'Hubi: rekord zniknął lub jest uszkodzony.\n' >&2
        return 1
    fi
    session="${REC[session]}"
    scope="${REC[scope]}"
    token="${REC[token]}"
    if [[ "${REC[state]}" == STARTING ]]; then
        rollback_starting_record "$hash"; rc=$?
        release_identity_lock
        return "$rc"
    fi
    if tmux_cmd has-session -t "$session" 2>/dev/null; then
        local live_token
        live_token="$(tmux_cmd show-option -qv -t "$session" @hubi-token 2>/dev/null || true)"
        if [[ "$live_token" != "$token" ]]; then
            release_identity_lock
            printf 'Hubi: sesja %s nie ma zweryfikowanego tokenu; odmowa (CONFLICT).\n' "$session" >&2
            return 1
        fi
        if ! session_is_dead "$session"; then
            if agent_pane "$session"; then
                tmux_cmd send-keys -t "$FOUND_PANE" C-c >/dev/null 2>&1 || true
            fi
            wait_scope_inactive "$scope" 30 || true
        fi
    fi
    terminate_scope "$scope" "$token"; rc=$?
    if (( rc == 0 )); then
        # An already-absent session is cleanup success, not a failure to
        # report: only attempt (and require) removal when the session is
        # actually still there (P2-01) — an ORPHANED object (session gone,
        # scope was the only thing still alive) must not be misreported as
        # a failed stop just because there is nothing left to kill.
        local kill_ok=1
        if [[ -n "$session" ]] && tmux_cmd has-session -t "$session" 2>/dev/null; then
            tmux_cmd kill-session -t "$session" >/dev/null 2>&1 || kill_ok=0
        fi
        if (( kill_ok )); then
            delete_state_record "$hash"
        else
            printf 'Hubi: scope zakończony, ale nie udało się usunąć sesji tmux %s; rekord zachowany.\n' "$session" >&2
            rc=1
        fi
    fi
    release_identity_lock
    return "$rc"
}

stale_objects_menu() {
    local -a hashes=()
    local hash choice index diagnosis
    while true; do
        clear_screen
        mapfile -t hashes < <(list_trusted_records)
        printf '\n  OSIEROCONE / NIEZNANE OBIEKTY\n  ──────────────────────────────────\n\n'
        if (( ${#hashes[@]} == 0 )); then
            printf '  Brak zaufanych rekordów.\n'
        else
            index=0
            for hash in "${hashes[@]}"; do
                ((index += 1))
                load_state_record "$hash" || { printf '  [%d] %s  <uszkodzony rekord>\n' "$index" "$hash"; continue; }
                diagnosis="$(trusted_record_diagnosis "$hash")"
                printf '  [%d] %s/%s  %s\n      %s  [%s]\n' \
                    "$index" "${REC[agent]}" "${REC[instance]}" "${REC[canonical_path]}" "${REC[session]}" "$diagnosis"
            done
        fi
        printf '\n  [numer] Zatrzymaj wybrany obiekt  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            b|B) return ;;
            [1-9]|[1-9][0-9])
                index=$((choice - 1))
                if (( index >= 0 && index < ${#hashes[@]} )); then
                    if stop_trusted_record "${hashes[$index]}"; then
                        MENU_HINT="Zatrzymano."
                    else
                        MENU_HINT="Nie udało się zatrzymać (patrz diagnostyka powyżej)."
                    fi
                    pause_for_ack
                else
                    unknown_key
                fi
                ;;
            *) unknown_key ;;
        esac
    done
}

project_menu() {
    local repo_key="$1" directory="$2" choice git_state
    while true; do
        clear_screen
        git_state="$(git_summary "$directory")"
        printf '\n  ╭────────────────────────────────────────╮\n  │          HUBINET DEVBOX — v%s          │\n  ╰────────────────────────────────────────╯\n\n' "$HUBI_VERSION"
        printf '  Projekt: %s\n  Git:     %s\n' "$repo_key" "$git_state"
        print_project_instances claude "$directory"
        print_project_instances codex "$directory"
        printf '\n'
        show_hint
        printf '  [1] Codex primary — uruchom / podłącz / zobacz EXITED\n'
        printf '  [2] Claude primary — uruchom / podłącz / zobacz EXITED\n'
        printf '  [3] Shell projektu\n  [g] Git status\n'
        printf '  [i] Zarządzaj instancjami\n'
        printf '  [c] Zakończ Codexa (także EXITED)\n  [a] Zakończ Claude (także EXITED)\n  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            1) start_agent codex "$repo_key" || true ;;
            2) start_agent claude "$repo_key" || true ;;
            3) project_shell "$repo_key" || true ;;
            g|G) show_git_status "$directory" "$repo_key" ;;
            i|I) manage_instances_menu "$directory" ;;
            c|C) kill_agent codex "$directory" || true ;;
            a|A) kill_agent claude "$directory" || true ;;
            b|B) return ;;
            *) unknown_key ;;
        esac
    done
}

main_menu() {
    local page=0 page_size=9 pages start end i index choice repo root
    local host_name user_name session_total codex_state claude_state
    local -a repos=()
    if [[ -n "${TMUX:-}" ]]; then
        printf 'Hubi: menu działa wyłącznie poza tmuxem. Odłącz sesję i spróbuj ponownie.\n' >&2
        return 1
    fi
    while true; do
        clear_screen
        mapfile -t repos < <(repo_list)
        root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null || true)"
        pages=$(( (${#repos[@]} + page_size - 1) / page_size )); (( pages == 0 )) && pages=1
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size)); (( end > ${#repos[@]} )) && end=${#repos[@]}
        host_name="$(hostname)"
        user_name="$(whoami)"
        session_total="$(session_count)"
        printf '\n  ╭────────────────────────────────────────╮\n  │          HUBINET DEVBOX — v%s          │\n  ╰────────────────────────────────────────╯\n\n' "$HUBI_VERSION"
        printf '  Host:     %s\n  User:     %s\n  Sesje:    %s\n  Projekty (strona %d/%d):\n\n' \
            "$host_name" "$user_name" "$session_total" "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            repo="${repos[$i]}"
            begin_render_critical
            codex_state="$(agent_status codex "$root/$repo")"
            end_render_critical
            begin_render_critical
            claude_state="$(agent_status claude "$root/$repo")"
            end_render_critical
            printf '  [%d] %-20s C:%-18s A:%s\n' "$((i - start + 1))" "$repo" \
                "$codex_state" "$claude_state"
        done
        if (( ${#repos[@]} == 0 )); then printf '  Nie znaleziono repozytoriów Git pod %s.\n' "$REPOS_ROOT"; fi
        printf '\n  [n] Następna  [p] Poprzednia  [s] Sesje\n  [o] Osierocone/nieznane obiekty\n'
        printf '  [h] Shell  [q] Zwykły prompt  [x] Wyloguj\n  > '
        if ! read_choice choice; then return 0; fi
        case "$choice" in
            s|S) sessions_menu ;;
            o|O) stale_objects_menu ;;
            h|H) normal_shell ;;
            q|Q) clear_screen; return 98 ;;
            x|X) clear_screen; return 99 ;;
            n|N) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            p|P) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            [1-9])
                index=$((start + choice - 1))
                if (( index < end )); then
                    repo="${repos[$index]}"
                    if resolve_repo "$repo"; then project_menu "$RESOLVED_REPO_KEY" "$RESOLVED_REPO_DIR"; else pause_for_ack; fi
                else unknown_key; fi
                ;;
            *) unknown_key ;;
        esac
    done
}

usage() {
    printf '%s\n' 'Użycie:' '  hubi' \
        '  hubi codex REPO [INSTANCE [new|resume]]' \
        '  hubi claude REPO [INSTANCE [new|resume]]' \
        '  hubi shell REPO' '  hubi sessions'
}

hubi_main() {
    local command_name="${1:-menu}" rc=0
    if [[ -n "${HUBI_ACTIVE:-}" ]]; then
        printf 'Hubi: zagnieżdżone uruchomienie jest zabronione (HUBI_ACTIVE jest ustawione).\n' >&2
        return 125
    fi
    export HUBI_ACTIVE=1
    install_signal_handlers
    enable_safe_input
    case "$command_name" in
        menu) main_menu || rc=$? ;;
        codex|claude)
            if (( $# < 2 || $# > 4 )); then
                usage >&2; rc=2
            else
                start_agent "$command_name" "$2" "${3:-primary}" "${4:-new}" || rc=$?
            fi
            ;;
        shell) if (( $# != 2 )); then usage >&2; rc=2; else project_shell "$2" || rc=$?; fi ;;
        sessions) if (( $# != 1 )); then usage >&2; rc=2; else sessions_menu || rc=$?; fi ;;
        *) usage >&2; rc=2 ;;
    esac
    return "$rc"
}

if [[ "${BASH_SOURCE[0]}" == "$0" && "${1:-}" == "__start-locked" ]]; then
    shift
    if (( $# < 7 )); then
        printf 'Hubi: niepełne argumenty wewnętrznego startu.\n' >&2
        exit 2
    fi
    ensure_agent_session_locked "$@"
    exit $?
fi

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    hubi_main "$@"
    exit $?
fi
