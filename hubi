#!/usr/bin/env bash
set -uo pipefail

HUBI_VERSION=5
HUBI_SCRIPT_PATH="$(realpath -e -- "${BASH_SOURCE[0]}")"
REPOS_ROOT="${HUBI_REPOS:-$HOME/repos}"
TMUX_BIN="${HUBI_TMUX_BIN:-tmux}"
SYSTEMD_RUN_BIN="${HUBI_SYSTEMD_RUN_BIN:-systemd-run}"
SYSTEMCTL_BIN="${HUBI_SYSTEMCTL_BIN:-systemctl}"
LOGINCTL_BIN="${HUBI_LOGINCTL_BIN:-loginctl}"
FLOCK_BIN="${HUBI_FLOCK_BIN:-flock}"
BASH_BIN="${HUBI_BASH_BIN:-bash}"
HUBI_TMUX_SERVICE="${HUBI_TMUX_SERVICE:-hubi-tmux.service}"
HUBI_PROC_ROOT="${HUBI_PROC_ROOT:-/proc}"

CODEX_BIN="${HUBI_CODEX_BIN:-$HOME/.npm-global/bin/codex}"
[[ -x "$CODEX_BIN" ]] || CODEX_BIN="$(command -v codex 2>/dev/null || true)"
CLAUDE_BIN="${HUBI_CLAUDE_BIN:-$HOME/.local/bin/claude}"
[[ -x "$CLAUDE_BIN" ]] || CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"

MENU_HINT=""
RESOLVED_REPO_DIR=""
RESOLVED_REPO_KEY=""
RESOLVED_REPO_ID=""
FOUND_SESSION=""
FOUND_PANE=""
ENSURED_SESSION=""
ATTACH_MODE=""
HUBI_LOCK_TIMEOUT="${HUBI_LOCK_TIMEOUT:-3}"
HUBI_PASTE_TIMEOUT="${HUBI_PASTE_TIMEOUT:-5}"

effective_hubi_socket() {
    if [[ -n "${HUBI_TMUX_SOCKET_PATH:-}" ]]; then
        printf '%s' "$HUBI_TMUX_SOCKET_PATH"
    else
        printf '%s/tmux-%s/hubi' "${XDG_RUNTIME_DIR:-/run/user/$UID}" "$UID"
    fi
}

# Inspection of the dedicated v5 server must never turn into server creation.
# tmux 3.6b's global -N option makes that guarantee explicit.
tmux_inspect_cmd() {
    tmux_cmd "$@"
}

current_login_user() { id -un; }

linger_state() {
    local user value
    user="$(current_login_user)" || return 1
    value="$("$LOGINCTL_BIN" show-user "$user" --property=Linger --value 2>/dev/null)" || return 1
    case "$value" in yes|no) printf '%s' "$value" ;; *) return 1 ;; esac
}

kill_user_processes_state() {
    local user value
    user="$(current_login_user)" || return 1
    value="$("$LOGINCTL_BIN" show-user "$user" --property=KillProcesses --value 2>/dev/null)" || return 1
    [[ -n "$value" ]] || return 1
    printf '%s' "$value"
}

user_manager_available() {
    "$SYSTEMCTL_BIN" --user show-environment >/dev/null 2>&1
}

scope_kill_capability_available() {
    local help
    user_manager_available || return 1
    help="$("$SYSTEMCTL_BIN" kill --help 2>&1 || true)"
    [[ "$help" == *"--kill-whom=WHOM"* && "$help" == *"--signal=SIGNAL"* ]]
}

hubi_service_active() {
    "$SYSTEMCTL_BIN" --user is-active --quiet "$HUBI_TMUX_SERVICE" 2>/dev/null
}

hubi_server_pid() {
    local pid
    pid="$(tmux_inspect_cmd display-message -p '#{pid}' 2>/dev/null)" || return 1
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    printf '%s' "$pid"
}

server_cgroup_for_pid() {
    local pid="$1" cgroup
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ -r "$HUBI_PROC_ROOT/$pid/cgroup" ]] || return 1
    cgroup="$(awk -F: '$1 == "0" { print $3; exit }' "$HUBI_PROC_ROOT/$pid/cgroup")"
    [[ -n "$cgroup" ]] || return 1
    printf '%s' "$cgroup"
}

HUBI_SERVER_PID=""
HUBI_SERVER_CGROUP=""
HUBI_OWNERSHIP_VERDICT="FAIL"

verify_hubi_server_ownership() {
    local pid cgroup
    HUBI_SERVER_PID=""
    HUBI_SERVER_CGROUP=""
    HUBI_OWNERSHIP_VERDICT="FAIL"
    hubi_service_active || return 1
    pid="$(hubi_server_pid)" || return 1
    cgroup="$(server_cgroup_for_pid "$pid")" || return 1
    HUBI_SERVER_PID="$pid"
    HUBI_SERVER_CGROUP="$cgroup"
    if [[ "$cgroup" != */"$HUBI_TMUX_SERVICE" ]]; then
        return 1
    fi
    HUBI_OWNERSHIP_VERDICT="PASS"
}

require_anchored_server() {
    if verify_hubi_server_ownership; then return 0; fi
    printf 'Hubi: dedykowany serwer tmux nie jest aktywnym serwerem należącym dokładnie do %s.\n' \
        "$HUBI_TMUX_SERVICE" >&2
    printf 'Hubi: odmowa utworzenia pracy; uruchom "hubi doctor" po poprawnej instalacji usługi.\n' >&2
    return 1
}

require_linger() {
    local state user
    user="$(current_login_user 2>/dev/null || printf USER)"
    if ! state="$(linger_state)"; then
        printf 'Hubi: nie można potwierdzić stanu Linger dla użytkownika %s; odmowa utworzenia pracy.\n' \
            "$user" >&2
        return 1
    fi
    if [[ "$state" != "yes" ]]; then
        printf 'Hubi: Linger=no dla użytkownika %s; odmowa utworzenia pracy.\n' "$user" >&2
        printf 'Hubi: uruchom z odpowiednimi uprawnieniami: loginctl enable-linger %s\n' "$user" >&2
        return 1
    fi
}

runtime_creation_preflight() {
    if ! user_manager_available; then
        printf 'Hubi: magistrala systemd --user jest niedostępna; odmowa utworzenia pracy.\n' >&2
        return 1
    fi
    require_linger || return 1
    require_scope_kill_capability || return 1
    require_anchored_server || return 1
}

hubi_scope_inventory() {
    "$SYSTEMCTL_BIN" --user list-units --all --type=scope --no-legend --plain 2>/dev/null \
        | awk '$1 ~ /^hubi-(codex|claude|terminal)-.*\.scope$/ { print $1 " " $3 " " $4 }'
}

hubi_doctor() {
    local linger="unknown" kill_processes="unknown" manager="unreachable"
    local service="inactive" pid="unavailable" cgroup="unavailable" ownership="FAIL"
    local exit_empty="unavailable" kill_capability="unavailable" tmux_version inventory
    local failures=0 warnings=0

    tmux_version="$("$TMUX_BIN" -V 2>/dev/null || printf 'unavailable')"
    linger="$(linger_state 2>/dev/null || printf 'unknown')"
    kill_processes="$(kill_user_processes_state 2>/dev/null || printf 'unknown')"
    [[ "$kill_processes" == "unknown" ]] && ((warnings += 1))
    if user_manager_available; then manager="reachable"; else ((failures += 1)); fi
    if hubi_service_active; then service="active"; else ((failures += 1)); fi
    if verify_hubi_server_ownership; then
        pid="$HUBI_SERVER_PID"
        cgroup="$HUBI_SERVER_CGROUP"
        ownership="$HUBI_OWNERSHIP_VERDICT"
    else
        [[ -n "$HUBI_SERVER_PID" ]] && pid="$HUBI_SERVER_PID"
        [[ -n "$HUBI_SERVER_CGROUP" ]] && cgroup="$HUBI_SERVER_CGROUP"
        ((failures += 1))
    fi
    exit_empty="$(tmux_inspect_cmd show-options -gv exit-empty 2>/dev/null || printf 'unavailable')"
    [[ "$exit_empty" == "off" ]] || ((failures += 1))
    if scope_kill_capability_available; then kill_capability="available"; else ((failures += 1)); fi
    [[ "$linger" == "yes" ]] || ((failures += 1))
    inventory="$(hubi_scope_inventory || true)"

    printf 'Hubi doctor\n'
    printf '  Hubi version:             %s\n' "$HUBI_VERSION"
    printf '  tmux version:             %s\n' "$tmux_version"
    printf '  Hubi socket:              %s\n' "$(effective_hubi_socket)"
    printf '  Linger:                   %s\n' "$linger"
    printf '  KillUserProcesses:        %s (information only)\n' "$kill_processes"
    printf '  systemd user manager:     %s\n' "$manager"
    printf '  %s:      %s\n' "$HUBI_TMUX_SERVICE" "$service"
    printf '  tmux server PID:          %s\n' "$pid"
    printf '  tmux server cgroup:       %s\n' "$cgroup"
    printf '  server ownership:         %s\n' "$ownership"
    printf '  exit-empty:               %s\n' "$exit_empty"
    printf '  full-cgroup kill:         %s\n' "$kill_capability"
    printf '  managed scopes:\n'
    if [[ -n "$inventory" ]]; then printf '%s\n' "$inventory" | sed 's/^/    /'; else printf '    (none)\n'; fi

    if [[ "$linger" == "no" ]]; then
        printf '  Remediation: loginctl enable-linger %s (run with appropriate privileges)\n' \
            "$(current_login_user 2>/dev/null || printf USER)"
    elif [[ "$linger" == "unknown" ]]; then
        printf '  Linger could not be verified; creation must fail closed.\n'
    fi
    if (( failures == 0 )); then
        if (( warnings > 0 )); then
            printf 'Summary: WARN - ready for creation with %d informational warning(s).\n' "$warnings"
            return 0
        fi
        printf 'Summary: PASS - ready to create Hubi-managed work.\n'
        return 0
    fi
    printf 'Summary: FAIL - not ready to create Hubi-managed work (%d failed checks).\n' "$failures"
    return 1
}

tmux_cmd() {
    command env -u HUBI_ACTIVE "$TMUX_BIN" -N -S "$(effective_hubi_socket)" "$@"
}

wait_for_pane_cwd() {
    local target="$1" expected="$2" attempt current
    # tmux 3.6 can return from new-session before the pane child finishes chdir/exec.
    for attempt in {0..10}; do
        current="$(tmux_cmd display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || true)"
        [[ "$current" == "$expected" ]] && return 0
        (( attempt == 10 )) && break
        sleep 0.05
    done
    return 1
}

sanitize_tmux_environment() {
    tmux_cmd set-environment -gu HUBI_ACTIVE >/dev/null 2>&1 || true
}

clear_screen() { printf '\033[2J\033[H'; }

enable_safe_input() {
    # Pasted content is bracketed on supporting terminals. Whole-line reads make
    # both those wrappers and ordinary multi-byte escape sequences invalid.
    if [[ -t 0 && -t 1 ]]; then printf '\033[?2004h'; fi
}

disable_safe_input() {
    if [[ -t 1 ]]; then printf '\033[?2004l'; fi
}

discard_queued_input() {
    # A choice is one complete input event. Bytes already queued after its
    # newline belong to the same paste/burst and may not cross a menu boundary.
    while IFS= read -rsn1 -t 0.08 _; do :; done
}

discard_bracketed_paste() {
    local initial="$1" byte tail="$1" deadline complete=0 timeout="$HUBI_PASTE_TIMEOUT"

    if [[ "$initial" == *$'\e[201~'* ]]; then
        discard_queued_input
        return 0
    fi
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || timeout=5
    deadline=$((SECONDS + timeout))
    # read -n switches the tty to character reads, so the closing marker does
    # not need a trailing newline. Embedded newlines are deliberately ignored.
    while (( SECONDS < deadline )) && IFS= read -rsn1 -t "$((deadline - SECONDS))" byte; do
        tail="${tail: -5}${byte}"
        if [[ "$tail" == *$'\e[201~' ]]; then
            complete=1
            break
        fi
    done
    discard_queued_input
    if (( ! complete )); then
        printf '\n  Niepełne wklejenie zostało odrzucone po %ss.\n' "$timeout" >&2
        return 1
    fi
}

on_signal() {
    local signal="$1" rc="$2"
    trap - INT HUP TERM
    printf '\nHubi: odebrano %s; launcher kończy pracę (rc=%s).\n' "$signal" "$rc" >&2
    exit "$rc"
}

install_signal_handlers() {
    trap 'on_signal INT 130' INT
    trap 'on_signal HUP 129' HUP
    trap 'on_signal TERM 143' TERM
    trap disable_safe_input EXIT
}

pause_for_ack() {
    local value
    enable_safe_input
    discard_queued_input
    printf '\n  Enter, aby kontynuować... '
    if IFS= read -r value; then
        if [[ "$value" == *$'\e[200~'* ]]; then
            discard_bracketed_paste "$value"
        else
            discard_queued_input
        fi
    fi
    enable_safe_input
}

read_choice() {
    local variable="$1" value
    # This is deliberately not read -n1. A valid command is exactly one line
    # containing one character; arrows, terminal replies and paste are ignored.
    enable_safe_input
    if ! IFS= read -r value; then return 1; fi
    if [[ "$value" == *$'\e[200~'* ]]; then
        discard_bracketed_paste "$value"
        value=""
    else
        discard_queued_input
    fi
    printf -v "$variable" '%s' "$value"
}

show_hint() {
    if [[ -n "$MENU_HINT" ]]; then
        printf '  %s\n\n' "$MENU_HINT"
        MENU_HINT=""
    fi
}

unknown_key() { MENU_HINT="Nieznany wybór — wpisz jeden z pokazanych klawiszy i naciśnij Enter."; }
repo_error() { printf 'Hubi: %s\n' "$*" >&2; }

resolve_repo() {
    local argument="$1" root candidate top
    RESOLVED_REPO_DIR=""
    RESOLVED_REPO_KEY=""
    RESOLVED_REPO_ID=""

    if [[ -z "$argument" || "$argument" == /* || "$argument" == *$'\n'* ]]; then
        repo_error "nieprawidłowa nazwa repozytorium: ${argument:-<pusta>}"
        return 2
    fi
    case "/$argument/" in
        */../*|*/./*|*//* )
            repo_error "ścieżka repozytorium nie może zawierać '..', '.' ani pustych segmentów: $argument"
            return 2
            ;;
    esac

    if ! root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null)" || [[ ! -d "$root" ]]; then
        repo_error "katalog repozytoriów nie istnieje: $REPOS_ROOT"
        return 2
    fi
    if ! candidate="$(realpath -e -- "$root/$argument" 2>/dev/null)" || [[ ! -d "$candidate" ]]; then
        repo_error "repozytorium nie istnieje: $root/$argument"
        return 2
    fi
    case "$candidate/" in
        "$root"/*) ;;
        *) repo_error "repozytorium musi znajdować się pod $root"; return 2 ;;
    esac

    if ! top="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)"; then
        repo_error "to nie jest repozytorium Git: $candidate"
        return 2
    fi
    top="$(realpath -e -- "$top" 2>/dev/null)" || {
        repo_error "nie można rozwiązać katalogu repozytorium: $candidate"
        return 2
    }
    if [[ "$top" != "$candidate" ]]; then
        repo_error "podana ścieżka nie jest katalogiem głównym repozytorium Git: $argument"
        return 2
    fi
    RESOLVED_REPO_DIR="$candidate"
    RESOLVED_REPO_KEY="${candidate#"$root"/}"
    RESOLVED_REPO_ID="$(stat -Lc '%d:%i' -- "$candidate" 2>/dev/null)" || {
        repo_error "nie można ustalić tożsamości repozytorium: $candidate"
        RESOLVED_REPO_DIR=""
        RESOLVED_REPO_KEY=""
        return 2
    }
}

revalidate_repo_for_start() {
    local repo_key="$1" directory="$2" expected_id="$3" root candidate top actual_id
    if ! root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null)" || [[ ! -d "$root" ]]; then
        repo_error "katalog repozytoriów zniknął przed startem: $REPOS_ROOT"
        return 1
    fi
    if ! candidate="$(realpath -e -- "$directory" 2>/dev/null)" || [[ ! -d "$candidate" ]]; then
        repo_error "repozytorium zniknęło przed startem: $directory"
        return 1
    fi
    if [[ "$candidate" != "$directory" ]]; then
        repo_error "ścieżka repozytorium zmieniła się przed startem: $directory"
        return 1
    fi
    case "$candidate/" in
        "$root"/*) ;;
        *) repo_error "repozytorium nie znajduje się już pod $root"; return 1 ;;
    esac
    if ! top="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)" \
        || ! top="$(realpath -e -- "$top" 2>/dev/null)" \
        || [[ "$top" != "$candidate" ]]; then
        repo_error "katalog nie jest już tym samym repozytorium Git: $directory"
        return 1
    fi
    if [[ "${candidate#"$root"/}" != "$repo_key" ]]; then
        repo_error "klucz repozytorium zmienił się przed startem: $repo_key"
        return 1
    fi
    actual_id="$(stat -Lc '%d:%i' -- "$candidate" 2>/dev/null)" || {
        repo_error "nie można ponownie ustalić tożsamości repozytorium: $directory"
        return 1
    }
    if [[ -z "$expected_id" || "$actual_id" != "$expected_id" ]]; then
        repo_error "tożsamość repozytorium zmieniła się przed startem: $directory"
        return 1
    fi
}

repo_list() {
    local root directory top resolved
    root="$(realpath -e -- "$REPOS_ROOT" 2>/dev/null)" || return 0
    [[ -d "$root" ]] || return 0
    while IFS= read -r -d '' directory; do
        top="$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null || true)"
        [[ -n "$top" ]] || continue
        resolved="$(realpath -e -- "$top" 2>/dev/null || true)"
        [[ "$resolved" == "$directory" ]] || continue
        printf '%s\n' "${directory#"$root"/}"
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null) | sort
}

name_hash() { printf '%s' "$1" | sha256sum | cut -c1-12; }
instance_name_hash() { printf '%s\0%s' "$1" "$2" | sha256sum | cut -c1-12; }
safe_slug() {
    local slug
    slug="$(printf '%s' "$1" | tr -c '[:alnum:]_-' '-')"
    slug="${slug:0:28}"
    [[ -n "$slug" ]] || slug="repo"
    printf '%s' "$slug"
}
validate_instance_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]]; }

agent_session_name() {
    local agent="$1" repo_key="$2" instance="${3:-primary}"
    validate_instance_name "$instance" || return 2
    if [[ "$instance" == "primary" ]]; then
        printf 'hubi-%s-%s-%s' "$agent" "$(safe_slug "${repo_key##*/}")" "$(name_hash "$repo_key")"
    else
        printf 'hubi-%s-%s-%s-%s' "$agent" "$(safe_slug "${repo_key##*/}")" \
            "$(safe_slug "$instance")" "$(instance_name_hash "$repo_key" "$instance")"
    fi
}

terminal_session_name() {
    local repo_key="$1" instance="$2"
    validate_instance_name "$instance" || return 2
    printf 'hubi-terminal-%s-%s-%s' "$(safe_slug "${repo_key##*/}")" \
        "$(safe_slug "$instance")" "$(instance_name_hash "$repo_key" "$instance")"
}

terminal_scope_name() {
    local repo_key="$1" instance="$2"
    validate_instance_name "$instance" || return 2
    printf 'hubi-terminal-%s-%s.scope' "$(name_hash "$repo_key")" "$instance"
}

terminal_scope_instances() {
    local repo_key="$1" prefix scope instance
    prefix="hubi-terminal-$(name_hash "$repo_key")-"
    "$SYSTEMCTL_BIN" --user list-units --type=scope --state=active --no-legend --plain 2>/dev/null \
        | awk '{print $1}' \
        | while IFS= read -r scope; do
            [[ -n "$scope" && "$scope" == "$prefix"*.scope ]] || continue
            instance="${scope#"$prefix"}"
            instance="${instance%.scope}"
            validate_instance_name "$instance" || continue
            printf '%s\n' "$instance"
        done
}

find_terminal_session() {
    local repo_key="$1" instance="$2" session scope managed kind stored_repo stored_instance stored_scope
    FOUND_SESSION=""
    validate_instance_name "$instance" || return 2
    session="$(terminal_session_name "$repo_key" "$instance")" || return 2
    scope="$(terminal_scope_name "$repo_key" "$instance")" || return 2
    tmux_cmd has-session -t "=$session" 2>/dev/null || return 1
    managed="$(tmux_cmd show-option -qv -t "=$session:" @hubi-managed 2>/dev/null || true)"
    kind="$(tmux_cmd show-option -qv -t "=$session:" @hubi-kind 2>/dev/null || true)"
    stored_repo="$(tmux_cmd show-option -qv -t "=$session:" @hubi-repo 2>/dev/null || true)"
    stored_instance="$(tmux_cmd show-option -qv -t "=$session:" @hubi-instance 2>/dev/null || true)"
    stored_scope="$(tmux_cmd show-option -qv -t "=$session:" @hubi-scope 2>/dev/null || true)"
    if [[ "$managed" == "v5" && "$kind" == "terminal" && "$stored_repo" == "$repo_key" \
        && "$stored_instance" == "$instance" && "$stored_scope" == "$scope" ]]; then
        FOUND_SESSION="$session"
        return 0
    fi
    return 1
}

terminal_list() {
    local repo_key="$1" session managed kind stored_repo instance stored_scope expected_scope
    local -A found=()
    while IFS= read -r session; do
        [[ -n "$session" ]] || continue
        managed="$(tmux_cmd show-option -qv -t "=$session:" @hubi-managed 2>/dev/null || true)"
        kind="$(tmux_cmd show-option -qv -t "=$session:" @hubi-kind 2>/dev/null || true)"
        stored_repo="$(tmux_cmd show-option -qv -t "=$session:" @hubi-repo 2>/dev/null || true)"
        instance="$(tmux_cmd show-option -qv -t "=$session:" @hubi-instance 2>/dev/null || true)"
        stored_scope="$(tmux_cmd show-option -qv -t "=$session:" @hubi-scope 2>/dev/null || true)"
        expected_scope="$(terminal_scope_name "$repo_key" "$instance" 2>/dev/null || true)"
        if [[ "$managed" == "v5" && "$kind" == "terminal" && "$stored_repo" == "$repo_key" ]] \
            && validate_instance_name "$instance" && [[ "$stored_scope" == "$expected_scope" ]]; then
            printf '%s\n' "$instance"
            found["$instance"]=1
        fi
    done < <(tmux_cmd list-sessions -F '#S' 2>/dev/null | sort || true)
    while IFS= read -r instance; do
        [[ -n "$instance" && -z "${found[$instance]:-}" ]] || continue
        printf '%s\n' "$instance"
        found["$instance"]=1
    done < <(terminal_scope_instances "$repo_key" | sort -u)
}

agent_scope_name() {
    local agent="$1" repo_key="$2" instance="${3:-primary}"
    validate_instance_name "$instance" || return 2
    if [[ "$instance" == "primary" ]]; then
        printf 'hubi-%s-%s.scope' "$agent" "$(name_hash "$repo_key")"
    else
        # Keep the repo hash segment byte-for-byte identical to the primary
        # scope's, then append the (already charset-validated) instance name
        # verbatim. This lets an active secondary scope be mapped back to its
        # agent/repo/instance without any persistent state: repo_hash is a
        # fixed 12 hex-char field, so the trailing "-<instance>" is always
        # unambiguous to parse back out. See secondary_scope_instances().
        printf 'hubi-%s-%s-%s.scope' "$agent" "$(name_hash "$repo_key")" "$instance"
    fi
}

# Reverse agent_scope_name()'s secondary form: list instance names for
# (agent, repo_key) whose exact secondary scope is currently active, whether
# or not a tmux session still exists for them. No state is stored anywhere;
# this only reads live systemd --user unit state.
secondary_scope_instances() {
    local agent="$1" repo_key="$2" prefix scope instance
    prefix="hubi-${agent}-$(name_hash "$repo_key")-"
    "$SYSTEMCTL_BIN" --user list-units --type=scope --state=active --no-legend --plain 2>/dev/null \
        | awk '{print $1}' \
        | while IFS= read -r scope; do
            [[ -n "$scope" && "$scope" == "$prefix"*.scope ]] || continue
            instance="${scope#"$prefix"}"
            instance="${instance%.scope}"
            validate_instance_name "$instance" || continue
            printf '%s\n' "$instance"
        done
}

find_agent_session() {
    local agent="$1" repo_key="$2" instance="${3:-primary}"
    local session managed stored_agent stored_repo stored_instance
    FOUND_SESSION=""
    validate_instance_name "$instance" || return 2
    session="$(agent_session_name "$agent" "$repo_key" "$instance")"
    if tmux_cmd has-session -t "=$session" 2>/dev/null; then
        managed="$(tmux_cmd show-option -qv -t "=$session:" @hubi-managed 2>/dev/null || true)"
        stored_agent="$(tmux_cmd show-option -qv -t "=$session:" @hubi-agent 2>/dev/null || true)"
        stored_repo="$(tmux_cmd show-option -qv -t "=$session:" @hubi-repo 2>/dev/null || true)"
        stored_instance="$(tmux_cmd show-option -qv -t "=$session:" @hubi-instance 2>/dev/null || true)"
        if [[ "$managed" == "v5" && "$stored_agent" == "$agent" && "$stored_repo" == "$repo_key" \
            && "$stored_instance" == "$instance" ]]; then
            FOUND_SESSION="$session"
            return 0
        fi
    fi
    return 1
}

session_count() {
    local sessions
    sessions="$(tmux_cmd list-sessions -F '#S' 2>/dev/null || true)"
    if [[ -z "$sessions" ]]; then printf '0'; else printf '%s\n' "$sessions" | wc -l; fi
}

session_clients() {
    local clients
    clients="$(tmux_cmd list-clients -t "=$1" -F '#{client_name}' 2>/dev/null || true)"
    if [[ -z "$clients" ]]; then printf '0'; else printf '%s\n' "$clients" | wc -l; fi
}

agent_pane() {
    local session="$1" pane pane_session
    FOUND_PANE=""
    pane="$(tmux_cmd show-option -qv -t "=$session:" @hubi-pane 2>/dev/null || true)"
    [[ "$pane" == %* ]] || return 1
    pane_session="$(tmux_cmd display-message -p -t "$pane" '#S' 2>/dev/null || true)"
    [[ "$pane_session" == "$session" ]] || return 1
    FOUND_PANE="$pane"
}

session_is_managed() {
    [[ "$(tmux_cmd show-option -qv -t "=$1:" @hubi-managed 2>/dev/null || true)" == "v5" ]]
}

session_is_dead() {
    local session="$1"
    if session_is_managed "$session" \
        && [[ "$(tmux_cmd show-option -qv -t "=$session:" @hubi-kind 2>/dev/null || true)" != "terminal" ]]; then
        agent_pane "$session" || return 0
        [[ "$(tmux_cmd display-message -p -t "$FOUND_PANE" '#{pane_dead}' 2>/dev/null || true)" == "1" ]]
    else
        [[ "$(tmux_cmd display-message -p -t "=$session:" '#{pane_dead}' 2>/dev/null || true)" == "1" ]]
    fi
}

session_status() {
    local session="$1" clients
    if ! tmux_cmd has-session -t "=$session" 2>/dev/null; then
        printf '○ STOPPED'
    elif session_is_dead "$session"; then
        printf '⚠ EXITED'
    else
        clients="$(session_clients "$session")"
        if (( clients > 0 )); then printf '● ATTACHED (%d)' "$clients"; else printf '● RUNNING'; fi
    fi
}

agent_status() {
    local agent="$1" repo_key="$2" instance="${3:-primary}" scope
    scope="$(agent_scope_name "$agent" "$repo_key" "$instance")" || return 2
    if find_agent_session "$agent" "$repo_key" "$instance"; then
        if session_is_dead "$FOUND_SESSION" && scope_is_active "$scope"; then
            printf '⚠ EXITED / STALE SCOPE'
        elif ! session_is_dead "$FOUND_SESSION" && ! scope_is_active "$scope"; then
            printf '⚠ STALE SESSION'
        else
            session_status "$FOUND_SESSION"
        fi
    elif scope_is_active "$scope"; then
        printf '⚠ ORPHANED'
    else
        printf '○ STOPPED'
    fi
}

git_summary() {
    local directory="$1" branch state
    branch="$(git -C "$directory" branch --show-current 2>/dev/null || true)"
    [[ -n "$branch" ]] || branch="$(git -C "$directory" rev-parse --short HEAD 2>/dev/null || printf '?')"
    if [[ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]]; then state="dirty"; else state="clean"; fi
    printf '%s / %s' "$branch" "$state"
}

capture_session_output() {
    local session="$1"
    if session_is_managed "$session"; then
        if ! agent_pane "$session"; then
            printf 'Hubi: brak przypiętego panelu agenta w sesji %s.\n' "$session" >&2
            return 1
        fi
        tmux_cmd capture-pane -p -S -200 -t "$FOUND_PANE" 2>/dev/null || true
    else
        tmux_cmd capture-pane -p -S -200 -t "=$session:" 2>/dev/null || true
    fi
}

choose_attach_mode() {
    local session="$1" clients choice
    ATTACH_MODE=""
    clients="$(session_clients "$session")"
    if (( clients == 0 )); then ATTACH_MODE="write"; return 0; fi
    printf '\n  Sesja ma już podłączonych klientów: %d\n' "$clients"
    printf '  [v] Tylko podgląd\n  [s] Współdziel sterowanie\n'
    printf '  [p] Przejmij (odłącz pozostałych)\n  [b] Powrót\n  > '
    if ! read_choice choice; then return 1; fi
    case "$choice" in
        v|V) ATTACH_MODE="readonly" ;;
        s|S) ATTACH_MODE="write" ;;
        p|P) ATTACH_MODE="takeover" ;;
        b|B) return 1 ;;
        *) printf '  Nieznany wybór; nie podłączono sesji.\n'; return 1 ;;
    esac
}

attach_session() {
    local session="$1" mode rc=0
    if [[ -n "${TMUX:-}" ]]; then
        printf '\n  Hubi działa poza tmuxem. Najpierw odłącz bieżącą sesję.\n' >&2
        pause_for_ack
        return 1
    fi
    if ! tmux_cmd has-session -t "=$session" 2>/dev/null; then
        printf '\n  Nie ma sesji tmux: %s\n' "$session" >&2
        pause_for_ack
        return 1
    fi
    # Attaching is an explicit initialization boundary. Remove any stale
    # launcher-only guard before this client or later panes use the server.
    sanitize_tmux_environment
    choose_attach_mode "$session" || { enable_safe_input; discard_queued_input; return 0; }
    mode="$ATTACH_MODE"
    clear_screen
    case "$mode" in
        readonly) tmux_cmd attach-session -r -t "=$session" || rc=$? ;;
        takeover) tmux_cmd attach-session -d -t "=$session" || rc=$? ;;
        write) tmux_cmd attach-session -t "=$session" || rc=$? ;;
    esac
    enable_safe_input
    discard_queued_input
    if (( rc != 0 )); then
        printf '\n  BŁĄD: nie udało się podłączyć sesji %s (rc=%d).\n' "$session" "$rc" >&2
        printf '  Powyższy komunikat tmux został zachowany.\n' >&2
        pause_for_ack
        return "$rc"
    fi
    clear_screen
}

lock_root() {
    local root="${XDG_RUNTIME_DIR:-/tmp}/hubi-locks-${UID}"
    if [[ ! -d "$root" ]]; then install -d -m 700 -- "$root" || return 1; fi
    printf '%s' "$root"
}

ensure_agent_session() {
    local agent="$1" repo_key="$2" directory="$3" executable="$4"
    shift 4
    local -a arguments=("$@")
    local instance="${HUBI_AGENT_INSTANCE:-primary}" session locks lock_file lock_identity output rc expected_repo_id
    ENSURED_SESSION=""
    if ! validate_instance_name "$instance"; then
        printf 'Hubi: nieprawidłowa nazwa instancji: %s\n' "$instance" >&2
        return 2
    fi
    session="$(agent_session_name "$agent" "$repo_key" "$instance")"
    expected_repo_id="$RESOLVED_REPO_ID"
    runtime_creation_preflight || return 1
    revalidate_repo_for_start "$repo_key" "$directory" "$expected_repo_id" || return 1
    locks="$(lock_root)" || { printf 'Hubi: nie można utworzyć katalogu blokad startowych.\n' >&2; return 1; }
    if [[ "$instance" == "primary" ]]; then
        lock_identity="$agent:$repo_key"
        lock_file="$locks/$(name_hash "$lock_identity").lock"
    else
        lock_file="$locks/$agent-$(instance_name_hash "$repo_key" "$instance").lock"
    fi
    if [[ ! "$HUBI_LOCK_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
        printf 'Hubi: nieprawidłowy limit oczekiwania na blokadę: %s\n' "$HUBI_LOCK_TIMEOUT" >&2
        return 1
    fi

    # flock owns the descriptor in a supervisor. --close guarantees that the
    # worker, tmux server, agent and every descendant start without that fd.
    output="$("$FLOCK_BIN" --exclusive --close --wait "$HUBI_LOCK_TIMEOUT" \
        --conflict-exit-code 75 "$lock_file" \
        env -u HUBI_ACTIVE bash "$HUBI_SCRIPT_PATH" __start-locked \
        "$agent" "$repo_key" "$instance" "$directory" "$expected_repo_id" \
        "$executable" "${arguments[@]}" 2>&1)"
    rc=$?
    if (( rc == 75 )); then
        printf 'Hubi: limit %ss oczekiwania na blokadę startu (startup lock) %s/%s został przekroczony.\n' \
            "$HUBI_LOCK_TIMEOUT" "$agent" "$repo_key" >&2
        return 1
    fi
    if (( rc != 0 )); then
        printf 'Hubi: start %s/%s pod blokadą nie powiódł się (rc=%d).\n' "$agent" "$repo_key" "$rc" >&2
        [[ -z "$output" ]] || printf '%s\n' "$output" >&2
        return "$rc"
    fi
    ENSURED_SESSION="$session"
}

ensure_agent_session_locked() {
    local agent="$1" repo_key="$2" instance="$3" directory="$4" expected_repo_id="$5" executable="$6"
    shift 6
    local -a arguments=("$@")
    local session scope output pane start_command stored_agent stored_repo stored_instance
    validate_instance_name "$instance" || return 2
    session="$(agent_session_name "$agent" "$repo_key" "$instance")"
    scope="$(agent_scope_name "$agent" "$repo_key" "$instance")"

    if tmux_cmd has-session -t "=$session" 2>/dev/null; then
        stored_agent="$(tmux_cmd show-option -qv -t "=$session:" @hubi-agent 2>/dev/null || true)"
        stored_repo="$(tmux_cmd show-option -qv -t "=$session:" @hubi-repo 2>/dev/null || true)"
        stored_instance="$(tmux_cmd show-option -qv -t "=$session:" @hubi-instance 2>/dev/null || true)"
        [[ -n "$stored_instance" ]] || stored_instance="primary"
        if session_is_managed "$session" && [[ "$stored_agent" == "$agent" && "$stored_repo" == "$repo_key" \
            && "$stored_instance" == "$instance" ]] && agent_pane "$session"; then
            return 0
        fi

        # Recover only the exact bootstrap shape created by Hubi before it had
        # a chance to persist metadata. Never claim an arbitrary lookalike.
        start_command="$(tmux_cmd display-message -p -t "=$session:" '#{pane_start_command}' 2>/dev/null || true)"
        if [[ "$start_command" == "sleep 30" || "$(tmux_cmd show-option -qv -t "=$session:" @hubi-managed 2>/dev/null || true)" == "v5" ]]; then
            terminate_scope "$scope" || return 1
            tmux_cmd kill-session -t "=$session" || return 1
        else
            printf 'Hubi: sesja %s istnieje bez zweryfikowanych metadanych v5; odmowa przejęcia.\n' "$session" >&2
            return 1
        fi
    elif scope_is_active "$scope"; then
        printf 'Hubi: znaleziono osierocony scope %s; bezpieczne czyszczenie przed restartem.\n' "$scope" >&2
        terminate_scope "$scope" || return 1
    fi

    # This is the last check before tmux receives -c and before systemd creates
    # a scope. It also detects replacement of a repository at the same path.
    revalidate_repo_for_start "$repo_key" "$directory" "$expected_repo_id" || return 1
    require_anchored_server || return 1

    if ! output="$(tmux_cmd new-session -d -P -F '#{pane_id}' -s "$session" -c "$directory" -- sleep 30 2>&1)"; then
        printf 'Hubi: tmux nie utworzył sesji %s:\n%s\n' "$session" "$output" >&2
        return 1
    fi
    pane="$output"
    if [[ "$pane" != %* ]]; then
        printf 'Hubi: tmux nie zwrócił identyfikatora panelu agenta: %s\n' "$pane" >&2
        return 1
    fi

    if ! wait_for_pane_cwd "$pane" "$directory"; then
        printf 'Hubi: tmux nie zachował katalogu repozytorium %s; start został przerwany.\n' "$directory" >&2
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        return 1
    fi

    sanitize_tmux_environment
    if ! tmux_cmd set-option -t "=$session:" @hubi-managed v5 \
        || ! tmux_cmd set-option -t "=$session:" @hubi-agent "$agent" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-repo "$repo_key" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-instance "$instance" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-scope "$scope" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-pane "$pane" \
        || ! tmux_cmd set-window-option -t "$pane" remain-on-exit on \
        || ! tmux_cmd set-window-option -t "$pane" window-size largest; then
        printf 'Hubi: nie udało się utrwalić metadanych/ustawień sesji %s.\n' "$session" >&2
        return 1
    fi
    if ! tmux_cmd set-hook -t "=$session:" after-new-window \
        'set-window-option remain-on-exit on; set-window-option window-size largest'; then
        printf 'Hubi: nie udało się ustawić polityki nowych okien sesji %s.\n' "$session" >&2
        return 1
    fi

    if ! revalidate_repo_for_start "$repo_key" "$directory" "$expected_repo_id"; then
        printf 'Hubi: repozytorium zmieniło się przed utworzeniem scope; usuwanie sesji startowej %s.\n' "$session" >&2
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        return 1
    fi
    if ! output="$(tmux_cmd respawn-pane -k -t "$pane" -- \
        "$SYSTEMD_RUN_BIN" --user --scope --quiet --collect --unit="$scope" -- \
        "$executable" "${arguments[@]}" 2>&1)"; then
        printf 'Hubi: nie można uruchomić agenta w sesji %s:\n%s\n' "$session" "$output" >&2
        return 1
    fi
    for _ in {1..10}; do
        if session_is_dead "$session"; then
            printf 'Hubi: agent zakończył się podczas startu. Ostatnie wyjście:\n' >&2
            capture_session_output "$session" >&2
            return 1
        fi
        sleep 0.05
    done
}

start_agent() {
    local agent="$1" repo_argument="$2" instance="${3:-primary}" mode="${4:-new}" executable
    local -a arguments=()
    if ! validate_instance_name "$instance"; then
        printf 'Hubi: nieprawidłowa nazwa instancji: %s\n' "$instance" >&2
        return 2
    fi
    if [[ "$mode" != "new" && "$mode" != "resume" ]]; then
        printf 'Hubi: nieprawidłowy tryb startu: %s\n' "$mode" >&2
        return 2
    fi
    resolve_repo "$repo_argument" || { pause_for_ack; return 2; }

    # Existing RUNNING/ATTACHED/EXITED sessions remain inspectable even if the
    # agent executable was subsequently moved or removed.
    if find_agent_session "$agent" "$RESOLVED_REPO_KEY" "$instance"; then
        attach_session "$FOUND_SESSION"
        return $?
    fi

    case "$agent" in
        codex)
            executable="$CODEX_BIN"
            [[ "$mode" == "resume" ]] && arguments=(resume)
            ;;
        claude)
            executable="$CLAUDE_BIN"
            arguments=(--permission-mode bypassPermissions)
            [[ "$mode" == "resume" ]] && arguments+=(--resume)
            ;;
        *) printf 'Hubi: nieznany agent: %s\n' "$agent" >&2; return 2 ;;
    esac
    if [[ -z "$executable" || ! -x "$executable" ]]; then
        printf 'Hubi: nie znaleziono programu %s.\n' "$agent" >&2
        pause_for_ack
        return 1
    fi
    if ! HUBI_AGENT_INSTANCE="$instance" ensure_agent_session "$agent" "$RESOLVED_REPO_KEY" "$RESOLVED_REPO_DIR" \
        "$executable" "${arguments[@]}"; then
        printf '\n  Start agenta nie powiódł się; sesja EXITED zachowuje diagnostykę, jeśli powstała.\n' >&2
        pause_for_ack
        return 1
    fi
    attach_session "$ENSURED_SESSION"
}

scope_is_active() { "$SYSTEMCTL_BIN" --user is-active --quiet "$1" 2>/dev/null; }

require_scope_kill_capability() {
    local help
    if ! user_manager_available; then
        printf 'Hubi: magistrala systemd --user jest niedostępna; nie można zagwarantować pełnego kill cgroup.\n' >&2
        return 1
    fi
    help="$("$SYSTEMCTL_BIN" kill --help 2>&1 || true)"
    if [[ "$help" != *"--kill-whom=WHOM"* || "$help" != *"--signal=SIGNAL"* ]]; then
        printf 'Hubi: ten systemctl nie obsługuje wymaganego zabijania pełnego cgroup (--kill-whom=all).\n' >&2
        return 1
    fi
}

signal_scope() {
    local scope="$1" signal="$2" output
    require_scope_kill_capability || return 1
    if ! output="$("$SYSTEMCTL_BIN" --user kill --kill-whom=all --signal="$signal" "$scope" 2>&1)"; then
        if scope_is_active "$scope"; then
            printf 'Hubi: systemctl nie wysłał %s do pełnego scope %s:\n%s\n' "$signal" "$scope" "$output" >&2
            return 1
        fi
    fi
}

wait_scope_inactive() {
    local scope="$1" attempts="$2" i
    for ((i = 0; i < attempts; i++)); do scope_is_active "$scope" || return 0; sleep 0.1; done
    return 1
}

terminate_scope() {
    local scope="$1"
    scope_is_active "$scope" || return 0
    signal_scope "$scope" TERM || return 1
    wait_scope_inactive "$scope" 20 || true
    if scope_is_active "$scope"; then
        signal_scope "$scope" KILL || return 1
        wait_scope_inactive "$scope" 20 || true
    fi
    if scope_is_active "$scope"; then
        printf 'Hubi: scope %s nadal jest aktywny po TERM/KILL.\n' "$scope" >&2
        return 1
    fi
}

stop_agent_now() {
    local agent="$1" repo_key="$2" instance="${3:-primary}" session="" scope configured_scope
    if ! validate_instance_name "$instance"; then
        printf 'Hubi: nieprawidłowa nazwa instancji: %s\n' "$instance" >&2
        return 2
    fi
    scope="$(agent_scope_name "$agent" "$repo_key" "$instance")"
    if ! find_agent_session "$agent" "$repo_key" "$instance"; then
        if scope_is_active "$scope"; then
            printf 'Hubi: czyszczenie osieroconego scope %s (brak sesji tmux).\n' "$scope" >&2
            terminate_scope "$scope"
            return $?
        fi
        printf 'Hubi: %s dla %s nie działa.\n' "$agent" "$repo_key" >&2
        return 1
    fi
    session="$FOUND_SESSION"
    configured_scope="$(tmux_cmd show-option -qv -t "=$session:" @hubi-scope 2>/dev/null || true)"
    if [[ -n "$configured_scope" && "$configured_scope" == "$scope" ]]; then
        if ! session_is_dead "$session"; then
            if agent_pane "$session"; then
                tmux_cmd send-keys -t "$FOUND_PANE" C-c >/dev/null 2>&1 || true
            fi
            wait_scope_inactive "$scope" 30 || true
        fi
        terminate_scope "$scope" || return 1
    else
        printf 'Hubi: sesja %s nie ma zweryfikowanej granicy cgroup v5.\n' "$session" >&2
        printf 'Hubi: odmowa automatycznego zatrzymania; sesja i jej procesy pozostają bez zmian.\n' >&2
        return 1
    fi
    if ! tmux_cmd kill-session -t "=$session"; then
        printf 'Hubi: agent zatrzymany, ale nie udało się usunąć sesji tmux %s.\n' "$session" >&2
        return 1
    fi
}

kill_agent() {
    local agent="$1" repo_key="$2" instance="${3:-primary}" choice
    if ! validate_instance_name "$instance"; then
        printf 'Hubi: nieprawidłowa nazwa instancji: %s\n' "$instance" >&2
        return 2
    fi
    if ! find_agent_session "$agent" "$repo_key" "$instance"; then
        if ! scope_is_active "$(agent_scope_name "$agent" "$repo_key" "$instance")"; then
            printf '\n  %s/%s dla %s nie działa.\n' "$agent" "$instance" "$repo_key"; pause_for_ack; return 0
        fi
        printf '\n  Wykryto ORPHANED scope bez sesji tmux.\n'
    fi
    printf '\n  Zakończyć %s/%s dla %s i cały jego scope procesów?\n' "$agent" "$instance" "$repo_key"
    printf '  [y] Tak\n  [n] Nie\n  > '
    if ! read_choice choice; then return 0; fi
    case "$choice" in
        y|Y) if ! stop_agent_now "$agent" "$repo_key" "$instance"; then pause_for_ack; return 1; fi ;;
        n|N) ;;
        *) printf '  Anulowano: nieznany wybór.\n'; pause_for_ack ;;
    esac
}

project_shell() {
    resolve_repo "$1" || { pause_for_ack; return 2; }
    clear_screen
    printf '\n  Shell projektu: %s\n  Powrót do menu: exit\n\n' "$RESOLVED_REPO_KEY"
    (cd "$RESOLVED_REPO_DIR" || exit 1; bash)
    enable_safe_input
    discard_queued_input
    clear_screen
}

terminal_status() {
    local repo_key="$1" instance="$2" clients scope
    scope="$(terminal_scope_name "$repo_key" "$instance")" || return 2
    if ! find_terminal_session "$repo_key" "$instance"; then
        if scope_is_active "$scope"; then printf '⚠ ORPHANED'; else printf '○ STOPPED'; fi
        return
    fi
    if ! scope_is_active "$scope"; then
        printf '⚠ STALE SESSION'
        return
    fi
    clients="$(session_clients "$FOUND_SESSION")"
    if (( clients > 0 )); then printf '● ATTACHED (%d)' "$clients"; else printf '● RUNNING'; fi
}

start_terminal() {
    local repo_key="$1" instance="$2" session scope output pane directory expected_repo_id
    if ! validate_instance_name "$instance"; then
        printf 'Hubi: nieprawidłowa nazwa terminala: %s\n' "$instance" >&2
        return 2
    fi
    resolve_repo "$repo_key" || { pause_for_ack; return 2; }
    repo_key="$RESOLVED_REPO_KEY"
    directory="$RESOLVED_REPO_DIR"
    expected_repo_id="$RESOLVED_REPO_ID"
    if find_terminal_session "$repo_key" "$instance"; then
        attach_session "$FOUND_SESSION"
        return
    fi
    runtime_creation_preflight || { pause_for_ack; return 1; }
    session="$(terminal_session_name "$repo_key" "$instance")" || return 2
    scope="$(terminal_scope_name "$repo_key" "$instance")" || return 2
    if scope_is_active "$scope"; then
        printf 'Hubi: znaleziono osierocony scope terminala %s; bezpieczne czyszczenie przed restartem.\n' \
            "$scope" >&2
        terminate_scope "$scope" || { pause_for_ack; return 1; }
    fi
    sanitize_tmux_environment
    revalidate_repo_for_start "$repo_key" "$directory" "$expected_repo_id" \
        || { pause_for_ack; return 1; }
    require_anchored_server || { pause_for_ack; return 1; }
    if ! output="$(tmux_cmd new-session -d -P -F '#{pane_id}' -s "$session" -c "$directory" -- sleep 30 2>&1)"; then
        printf 'Hubi: tmux nie utworzył terminala %s:\n%s\n' "$session" "$output" >&2
        pause_for_ack
        return 1
    fi
    pane="$output"
    if [[ "$pane" != %* ]]; then
        printf 'Hubi: tmux nie zwrócił identyfikatora panelu terminala: %s\n' "$pane" >&2
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        pause_for_ack
        return 1
    fi
    if ! revalidate_repo_for_start "$repo_key" "$directory" "$expected_repo_id"; then
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        pause_for_ack
        return 1
    fi
    if ! wait_for_pane_cwd "$pane" "$directory"; then
        printf 'Hubi: tmux nie zachował katalogu repozytorium %s; start został przerwany.\n' "$directory" >&2
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        pause_for_ack
        return 1
    fi
    if ! tmux_cmd set-option -t "=$session:" @hubi-managed v5 \
        || ! tmux_cmd set-option -t "=$session:" @hubi-kind terminal \
        || ! tmux_cmd set-option -t "=$session:" @hubi-repo "$repo_key" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-instance "$instance" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-scope "$scope" \
        || ! tmux_cmd set-option -t "=$session:" @hubi-pane "$pane" \
        || ! tmux_cmd set-window-option -t "=$session:" window-size largest \
        || ! tmux_cmd set-hook -t "=$session:" after-new-window \
            'set-window-option window-size largest'; then
        printf 'Hubi: nie udało się zapisać metadanych terminala %s.\n' "$session" >&2
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        pause_for_ack
        return 1
    fi
    if ! revalidate_repo_for_start "$repo_key" "$directory" "$expected_repo_id"; then
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        pause_for_ack
        return 1
    fi
    if ! output="$(tmux_cmd respawn-pane -k -t "$pane" -- \
        "$SYSTEMD_RUN_BIN" --user --scope --quiet --collect --unit="$scope" -- \
        "$BASH_BIN" 2>&1)"; then
        printf 'Hubi: nie można uruchomić terminala w scope %s:\n%s\n' "$scope" "$output" >&2
        tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
        pause_for_ack
        return 1
    fi
    for _ in {1..20}; do
        if scope_is_active "$scope" \
            && [[ "$(tmux_cmd display-message -p -t "$pane" '#{pane_dead}' 2>/dev/null || true)" != "1" ]]; then
            attach_session "$session"
            return
        fi
        sleep 0.05
    done
    printf 'Hubi: terminal nie osiągnął aktywnego stanu w scope %s.\n' "$scope" >&2
    terminate_scope "$scope" || true
    tmux_cmd kill-session -t "=$session" >/dev/null 2>&1 || true
    pause_for_ack
    return 1
}

stop_terminal_now() {
    local repo_key="$1" instance="$2" session="" scope configured_scope
    scope="$(terminal_scope_name "$repo_key" "$instance")" || return 2
    if ! find_terminal_session "$repo_key" "$instance"; then
        if scope_is_active "$scope"; then
            printf 'Hubi: czyszczenie osieroconego scope terminala %s.\n' "$scope" >&2
            terminate_scope "$scope"
            return $?
        fi
        printf 'Hubi: terminal %s dla %s nie działa.\n' "$instance" "$repo_key" >&2
        return 1
    fi
    session="$FOUND_SESSION"
    configured_scope="$(tmux_cmd show-option -qv -t "=$session:" @hubi-scope 2>/dev/null || true)"
    if [[ "$configured_scope" != "$scope" ]]; then
        printf 'Hubi: terminal %s nie ma zweryfikowanej granicy cgroup v5; odmowa zatrzymania.\n' \
            "$session" >&2
        return 1
    fi
    terminate_scope "$scope" || return 1
    # With remain-on-exit disabled, tmux may remove the terminal session as
    # soon as its scoped Bash exits. Otherwise remove that exact session now.
    if tmux_cmd has-session -t "=$session" 2>/dev/null \
        && ! tmux_cmd kill-session -t "=$session"; then
        printf 'Hubi: scope terminala zatrzymany, ale nie udało się usunąć sesji tmux %s.\n' \
            "$session" >&2
        return 1
    fi
}

kill_terminal() {
    local repo_key="$1" instance="$2" choice
    if ! find_terminal_session "$repo_key" "$instance"; then
        printf '\n  Terminal %s dla %s nie działa.\n' "$instance" "$repo_key"
        pause_for_ack
        return 0
    fi
    printf '\n  Zakończyć terminal %s dla %s?\n' "$instance" "$repo_key"
    printf '  [y] Tak\n  [n] Nie\n  > '
    if ! read_choice choice; then return 0; fi
    case "$choice" in
        y|Y) stop_terminal_now "$repo_key" "$instance" || { pause_for_ack; return 1; } ;;
        n|N) ;;
        *) printf '  Anulowano: nieznany wybór.\n'; pause_for_ack ;;
    esac
}

terminal_menu() {
    local repo_key="$1" instance="$2" choice
    while find_terminal_session "$repo_key" "$instance"; do
        clear_screen
        printf '\n  TERMINAL — %s\n  ──────────────────────────────────\n\n' "$instance"
        printf '  Projekt: %s\n  Status:  %s\n\n' "$repo_key" "$(terminal_status "$repo_key" "$instance")"
        show_hint
        printf '  [a] Podłącz\n  [x] Zakończ terminal\n  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            a|A) if find_terminal_session "$repo_key" "$instance"; then attach_session "$FOUND_SESSION" || true; fi ;;
            x|X) kill_terminal "$repo_key" "$instance" || true ;;
            b|B) return ;;
            *) unknown_key ;;
        esac
    done
}

terminals_menu() {
    local repo_key="$1" page=0 page_size=9 pages start end i index choice instance
    local -a entries=()
    while true; do
        clear_screen
        mapfile -t entries < <(terminal_list "$repo_key" | sort)
        pages=$(( (${#entries[@]} + page_size - 1) / page_size )); (( pages == 0 )) && pages=1
        (( page >= pages )) && page=$((pages - 1))
        start=$((page * page_size)); end=$((start + page_size)); (( end > ${#entries[@]} )) && end=${#entries[@]}
        printf '\n  TERMINALE — %s (strona %d/%d)\n  ──────────────────────────────────\n\n' \
            "$repo_key" "$((page + 1))" "$pages"
        show_hint
        for ((i = start; i < end; i++)); do
            instance="${entries[$i]}"
            printf '  [%d] %-32s %s\n' "$((i - start + 1))" "$instance" \
                "$(terminal_status "$repo_key" "$instance")"
        done
        if (( ${#entries[@]} == 0 )); then printf '  Brak persistent terminali.\n'; fi
        printf '\n  [n] Nowy terminal'
        if (( pages > 1 )); then printf '  [>] Następna  [<] Poprzednia'; fi
        printf '\n  [b] Powrót\n  > '
        if ! read_choice choice; then return; fi
        case "$choice" in
            b|B) return ;;
            n|N)
                printf '\n  Nazwa terminala (litery, cyfry, _ lub -, maks. 32): '
                if ! read_choice instance; then return; fi
                if validate_instance_name "$instance"; then
                    start_terminal "$repo_key" "$instance" || true
                else
                    MENU_HINT="Nieprawidłowa nazwa terminala."
                fi
                ;;
            \>) if (( page + 1 < pages )); then ((page += 1)); else MENU_HINT="To ostatnia strona."; fi ;;
            \<) if (( page > 0 )); then ((page -= 1)); else MENU_HINT="To pierwsza strona."; fi ;;
            [1-9])
                index=$((start + choice - 1))
                if (( index < end )); then terminal_menu "$repo_key" "${entries[$index]}"; else unknown_key; fi
                ;;
            *) unknown_key ;;
        esac
    done
}

normal_shell() {
    clear_screen
    printf '\n  Shell ai-devbox\n  Powrót do menu: exit\n\n'
    bash
    enable_safe_input
