#!/usr/bin/env bash
set -uo pipefail

# Zerwane SSH nie może zostawić hubi kręcącego się w tle.
trap 'exit 0' HUP TERM

REPOS="$HOME/repos"

CODEX_BIN="$HOME/.npm-global/bin/codex"
[ -x "$CODEX_BIN" ] || CODEX_BIN="$(command -v codex 2>/dev/null || true)"

CLAUDE_BIN="$HOME/.local/bin/claude"
[ -x "$CLAUDE_BIN" ] || CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"

clear_screen() {
    printf '\033[2J\033[H'
}

pause() {
    echo
    if ! IFS= read -r -p "  Enter..." _; then
        exit 0
    fi
}

getkey() {
    local __var="$1"
    local value

    if ! IFS= read -rsn1 value; then
        exit 0
    fi

    printf -v "$__var" '%s' "$value"
    echo
}

session_count() {
    tmux list-sessions -F '#S' 2>/dev/null | wc -l
}

repo_list() {
    find "$REPOS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
    while read -r d; do
        [ -d "$d/.git" ] && basename "$d"
    done |
    sort
}

agent_session_name() {
    printf '%s-%s' "$1" "$2"
}

session_clients() {
    tmux list-clients -t "$1" 2>/dev/null | wc -l
}

agent_status() {
    local agent="$1"
    local repo="$2"
    local session
    session="$(agent_session_name "$agent" "$repo")"

    if tmux has-session -t "$session" 2>/dev/null; then
        local clients
        clients="$(session_clients "$session")"

        if [ "$clients" -gt 0 ]; then
            printf '● RUNNING (%s klient)' "$clients"
        else
            printf '● RUNNING'
        fi
    else
        printf '○ STOPPED'
    fi
}

git_summary() {
    local repo="$1"
    local dir="$REPOS/$repo"

    local branch state
    branch="$(git -C "$dir" branch --show-current 2>/dev/null || true)"
    [ -n "$branch" ] || branch="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo '?')"

    if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
        state="dirty"
    else
        state="clean"
    fi

    printf '%s / %s' "$branch" "$state"
}

attach_session() {
    local session="$1"

    if [ -n "${TMUX:-}" ]; then
        echo
        echo "  HUBI działa poza tmuxem."
        echo "  Najpierw: Ctrl+B, potem D"
        pause
        return 1
    fi

    clear_screen
    tmux attach-session -t "$session"
    clear_screen
}

start_codex() {
    local repo="$1"
    local dir="$REPOS/$repo"
    local session
    session="$(agent_session_name codex "$repo")"

    [ -d "$dir/.git" ] || {
        echo "Brak repo: $dir"
        pause
        return
    }

    [ -n "$CODEX_BIN" ] || {
        echo "Nie znaleziono Codexa."
        pause
        return
    }

    if ! tmux has-session -t "$session" 2>/dev/null; then
        tmux new-session \
            -d \
            -s "$session" \
            -c "$dir" \
            "$CODEX_BIN"

        sleep 0.5
    fi

    attach_session "$session"
}

start_claude() {
    local repo="$1"
    local dir="$REPOS/$repo"
    local session
    session="$(agent_session_name claude "$repo")"

    [ -d "$dir/.git" ] || {
        echo "Brak repo: $dir"
        pause
        return
    }

    [ -n "$CLAUDE_BIN" ] || {
        echo "Nie znaleziono Claude Code."
        pause
        return
    }

    if ! tmux has-session -t "$session" 2>/dev/null; then
        tmux new-session \
            -d \
            -s "$session" \
            -c "$dir" \
            "$CLAUDE_BIN --permission-mode bypassPermissions"

        sleep 0.5
    fi

    attach_session "$session"
}

kill_agent() {
    local agent="$1"
    local repo="$2"
    local session
    session="$(agent_session_name "$agent" "$repo")"

    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo
        echo "  $agent dla $repo nie działa."
        pause
        return
    fi

    echo
    echo "  Zakończyć sesję $session?"
    echo "  [y] Tak"
    echo "  [n] Nie"
    echo -n "  > "

    local key
    getkey key

    case "$key" in
        y|Y)
            tmux kill-session -t "$session"
            sleep 1
            ;;
    esac
}

project_shell() {
    local repo="$1"
    local dir="$REPOS/$repo"

    clear_screen
    echo
    echo "  Shell projektu: $repo"
    echo "  Powrót do menu: exit"
    echo

    (
        cd "$dir" || exit 1
        HUBI_ACTIVE=1 bash
    )

    clear_screen
}

normal_shell() {
    clear_screen
    echo
    echo "  Shell ai-devbox"
    echo "  Powrót do menu: exit"
    echo

    HUBI_ACTIVE=1 bash
    clear_screen
}

show_git_status() {
    local repo="$1"

    clear_screen
    echo
    echo "  GIT — $repo"
    echo "  ──────────────────────────────────"
    echo

    git -C "$REPOS/$repo" status -sb
    echo
    git -C "$REPOS/$repo" log -5 --oneline --decorate 2>/dev/null || true

    pause
}

sessions_menu() {
    while true; do
        clear_screen

        mapfile -t sessions < <(
            tmux list-sessions -F '#S' 2>/dev/null || true
        )

        echo
        echo "  HUBINET DEVBOX — SESJE"
        echo "  ──────────────────────────────────"
        echo

        if [ "${#sessions[@]}" -eq 0 ]; then
            echo "  Brak aktywnych sesji."
            pause
            return
        fi

        local i=1
        for s in "${sessions[@]:0:9}"; do
            local clients
            clients="$(session_clients "$s")"

            if [ "$clients" -gt 0 ]; then
                printf "  [%d] %-28s ● %s klient\n" "$i" "$s" "$clients"
            else
                printf "  [%d] %-28s ● aktywna\n" "$i" "$s"
            fi

            ((i++))
        done

        echo
        echo "  [b] Powrót"
        echo -n "  > "

        local choice
        getkey choice

        case "$choice" in
            b|B)
                return
                ;;
            [1-9])
                local index=$((choice - 1))
                if [ "$index" -lt "${#sessions[@]}" ]; then
                    attach_session "${sessions[$index]}"
                fi
                ;;
        esac
    done
}

project_menu() {
    local repo="$1"

    while true; do
        clear_screen

        echo
        echo "  ╭────────────────────────────────────────╮"
        echo "  │             HUBINET DEVBOX             │"
        echo "  ╰────────────────────────────────────────╯"
        echo
        echo "  Projekt: $repo"
        echo "  Git:     $(git_summary "$repo")"
        echo "  Codex:   $(agent_status codex "$repo")"
        echo "  Claude:  $(agent_status claude "$repo")"
        echo
        echo "  [1] Codex  — uruchom / wznów"
        echo "  [2] Claude — uruchom / wznów"
        echo "  [3] Shell projektu"
        echo "  [g] Git status"
        echo "  [c] Zakończ Codexa"
        echo "  [a] Zakończ Claude"
        echo "  [b] Powrót"
        echo -n "  > "

        local choice
        getkey choice

        case "$choice" in
            1)
                start_codex "$repo"
                ;;
            2)
                start_claude "$repo"
                ;;
            3)
                project_shell "$repo"
                ;;
            g|G)
                show_git_status "$repo"
                ;;
            c|C)
                kill_agent codex "$repo"
                ;;
            a|A)
                kill_agent claude "$repo"
                ;;
            b|B)
                return
                ;;
        esac
    done
}

main_menu() {
    if [ -n "${TMUX:-}" ]; then
        echo
        echo "HUBI menu działa poza tmuxem."
        echo "Odłącz sesję: Ctrl+B, potem D"
        return 1
    fi

    while true; do
        clear_screen

        mapfile -t repos < <(repo_list)

        echo
        echo "  ╭────────────────────────────────────────╮"
        echo "  │             HUBINET DEVBOX             │"
        echo "  ╰────────────────────────────────────────╯"
        echo
        echo "  Host:     $(hostname)"
        echo "  User:     $(whoami)"
        echo "  Sesje:    $(session_count)"
        echo
        echo "  Projekty:"
        echo

        local i=1
        for repo in "${repos[@]:0:9}"; do
            printf "    [%d] %-20s C:%-12s A:%s\n" \
                "$i" \
                "$repo" \
                "$(agent_status codex "$repo")" \
                "$(agent_status claude "$repo")"
            ((i++))
        done

        echo
        echo "  [s] Aktywne sesje"
        echo "  [h] Shell"
        echo "  [q] Zwykły prompt"
        echo "  [x] Wyloguj"
        echo -n "  > "

        local choice
        getkey choice

        case "$choice" in
            s|S)
                sessions_menu
                ;;
            h|H)
                normal_shell
                ;;
            q|Q)
                clear_screen
                return 98
                ;;
            x|X)
                clear_screen
                return 99
                ;;
            [1-9])
                local index=$((choice - 1))
                if [ "$index" -lt "${#repos[@]}" ]; then
                    project_menu "${repos[$index]}"
                fi
                ;;
        esac
    done
}

case "${1:-menu}" in
    menu)
        main_menu
        exit $?
        ;;

    codex)
        start_codex "${2:?repo required}"
        ;;

    claude)
        start_claude "${2:?repo required}"
        ;;

    shell)
        project_shell "${2:?repo required}"
        ;;

    sessions)
        sessions_menu
        ;;

    *)
        echo "Użycie:"
        echo "  hubi"
        echo "  hubi codex REPO"
        echo "  hubi claude REPO"
        echo "  hubi shell REPO"
        echo "  hubi sessions"
        exit 1
        ;;
esac
